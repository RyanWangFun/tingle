#!/usr/bin/env node
'use strict';

/**
 * tingle-core —— tingle 插件的确定性核心。
 *
 * 一句话职责：全部机械判定的唯一实现。跑一次吐几行结构化结果。
 * 它自己不进模型上下文，进的只有它吐出来的那几行。
 *
 * 五条命令：
 *   doctor            这台电脑装齐了没有
 *   resolve           这个项目在这台电脑上能不能直接开工
 *   refresh           把项目档案与项目总索引拉一份到本机缓存
 *   migrate           把旧结构就地升级（本机两件 + 项目档案）
 *   check <技能名>    这个技能这一次能不能跑
 *
 * 边界（2026-08-17 定）：
 *   - 程序只判「在不在、打不打得开、版本对不对、登记齐不齐」这类机械事实。
 *   - 声明里那些「合格条件」（就绪判据）程序一概不读——由 AI 在技能真正开跑时逐条判。
 *   - 程序只判不修：一切重建、补齐、放行归 project-readiness 与 migrate。
 */

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execFileSync, spawn } = require('child_process');

// ─────────────────────────────────────────────────────────────
// 常量
// ─────────────────────────────────────────────────────────────

const STATE_VERSION = 2;      // 本地指针 .tingle/state.json 的结构版本
const PROFILE_VERSION = 2;    // 项目档案的结构版本
const RESIDENT_VERSION = 2;   // 常驻件模版的结构版本

const STATE_REL = path.join('.tingle', 'state.json');
const CACHE_DIR_REL = path.join('.tingle', 'cache');
const CACHE_PROFILE_REL = path.join(CACHE_DIR_REL, '项目档案.json');
const CACHE_INDEX_REL = path.join(CACHE_DIR_REL, '项目索引.md');

const PROFILE_TITLE = 'tingle-项目档案';
const INDEX_TITLE = 'tingle-项目索引';
const ARCHIVE_FOLDER = '_tingle';

const RESIDENT_BEGIN = '<!-- tingle:常驻件 开始 -->';
const RESIDENT_END = '<!-- tingle:常驻件 结束 -->';
const RESIDENT_VERSION_RE = /<!--\s*tingle:常驻件-version\s+(\d+)\s*-->/;
const RESIDENT_HOSTS = ['CLAUDE.md', 'AGENTS.md'];

const CACHE_STALE_LINE =
  '本缓存已失效：本次会话未能从云盘拉取。请直接读云盘，不要使用任何旧副本。';

// resolve 的五种结论。第五种「配置不完整」由 Ryan 2026-08-17 拍板新增：
// 原本只有四种，装不下「文件在、格式也对，但某一栏是空的」这种情况。
const VERDICT = {
  OK: '正常',
  NO_STATE: '本机未配置',
  INCOMPLETE: '配置不完整',
  STALE: '结构旧',
  UNREACHABLE: '打不开',
};

// 三种资源类型，及各自在项目档案里必须填的值字段
const TYPE_VALUE_FIELDS = {
  'lark-doc': ['link'],
  'lark-base': ['base_token', 'table_id'],
  'lark-drive': ['folder_token'],
};

// 声明块里标这一项「每次输入不一样」时，程序不去档案找它的地址、也不探活。
// 由 Ryan 2026-08-17 拍板新增（原先输入只分「随项目变」「跨项目同一份」两类，
// 装不下「每次跑都是另一份」的那类，比如这次要校对的那篇稿子）。
const PER_RUN_KEY = '每次输入不一样';

const PLUGIN_ROOT = path.resolve(__dirname, '..');

// ─────────────────────────────────────────────────────────────
// 基础工具
// ─────────────────────────────────────────────────────────────

function readFileSafe(p) {
  try { return fs.readFileSync(p, 'utf8'); } catch (e) { return null; }
}

function existsSafe(p) {
  try { fs.accessSync(p); return true; } catch (e) { return false; }
}

/** 跑一条任意命令，只为探测它在不在、跑不跑得通。永不抛异常。 */
function run(cmd, args, timeout) {
  try {
    const out = execFileSync(cmd, args, {
      encoding: 'utf8',
      timeout: timeout || 15000,
      maxBuffer: 4 * 1024 * 1024,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    return { ok: true, stdout: out };
  } catch (e) {
    return { ok: false, stdout: e && e.stdout ? String(e.stdout) : '' };
  }
}

/** 跑一条 lark-cli 命令。永不抛异常，一律回结构化结果。 */
function lark(args, opts = {}) {
  const timeout = opts.timeout || 45000;
  try {
    const out = execFileSync('lark-cli', args, {
      encoding: 'utf8',
      timeout,
      maxBuffer: 64 * 1024 * 1024,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    return { ok: true, stdout: out };
  } catch (e) {
    const stderr = e.stderr ? String(e.stderr) : '';
    const stdout = e.stdout ? String(e.stdout) : '';
    return {
      ok: false,
      stdout,
      stderr,
      code: typeof e.status === 'number' ? e.status : null,
      message: e.message || '',
    };
  }
}

/**
 * 跑一条 lark-cli 命令并把输出当 JSON 解析。
 * lark-cli 出错时同样吐结构化 JSON（含 error.code / error.message），
 * 所以失败路径也先试着解析——拿到的错误码要带进 resolve 的「打不开」结论里。
 */
function larkJson(args, opts = {}) {
  const r = lark(args, opts);
  const text = (r.stdout && r.stdout.trim()) ? r.stdout : (r.stderr || '');
  let parsed = null;
  try { parsed = JSON.parse(text); } catch (e) { /* 不是 JSON，走下面的兜底 */ }

  if (parsed && parsed.ok === false) {
    const err = parsed.error || {};
    return {
      ok: false,
      error: err.message ? String(err.message) : 'lark-cli 报错但没给消息',
      code: err.code !== undefined ? err.code : null,
    };
  }
  if (!r.ok) {
    const brief = (r.stderr || r.message || '').trim().split('\n')[0] || '命令执行失败';
    return { ok: false, error: brief.slice(0, 300), code: r.code };
  }
  if (!parsed) {
    return { ok: false, error: 'lark-cli 返回的不是合法 JSON', code: null };
  }
  return { ok: true, data: parsed };
}

/** 从一段 markdown 里抠出第一个 ```json 代码块并解析。 */
function extractJsonBlock(md) {
  if (typeof md !== 'string') return { ok: false, error: '内容不是文本' };
  const m = md.match(/```json\s*\r?\n([\s\S]*?)\r?\n```/);
  if (!m) return { ok: false, error: '正文里没有 json 代码块' };
  try {
    return { ok: true, value: JSON.parse(m[1]), raw: m[1] };
  } catch (e) {
    return { ok: false, error: 'json 代码块解析失败：' + e.message };
  }
}

function isNonEmpty(v) {
  return typeof v === 'string' ? v.trim().length > 0 : v !== undefined && v !== null;
}

function dig(obj, ...keys) {
  let cur = obj;
  for (const k of keys) {
    if (cur === null || typeof cur !== 'object') return undefined;
    cur = cur[k];
  }
  return cur;
}

// ─────────────────────────────────────────────────────────────
// 输出
// ─────────────────────────────────────────────────────────────

let WANT_JSON = false;

function emit(payload, humanLines) {
  if (WANT_JSON) {
    process.stdout.write(JSON.stringify(payload, null, 2) + '\n');
  } else {
    process.stdout.write(humanLines.filter(l => l !== null && l !== undefined).join('\n') + '\n');
  }
}

function bullet(list) {
  return list.map(s => '  - ' + s);
}

// ─────────────────────────────────────────────────────────────
// 读本机三样：本地指针 / 常驻件 / 插件自身
// ─────────────────────────────────────────────────────────────

/**
 * 读本地指针。回四种态之一：
 *   missing      文件不在        → resolve 判「本机未配置」
 *   unparsable   文件在、解析不了 → resolve 判「配置不完整」（本机件，重建即可）
 *   incomplete   三字段有缺或为空 → resolve 判「配置不完整」
 *   ok           齐了（版本另判）
 */
function readState(cwd) {
  const p = path.join(cwd, STATE_REL);
  if (!existsSafe(p)) return { status: 'missing', path: p };
  const raw = readFileSafe(p);
  if (raw === null) return { status: 'unparsable', path: p, reason: '文件读不出来' };
  let v;
  try { v = JSON.parse(raw); } catch (e) {
    return { status: 'unparsable', path: p, reason: 'JSON 解析失败：' + e.message };
  }
  const missing = [];
  if (!isNonEmpty(v.tingle_state_version) && v.tingle_state_version !== 0) missing.push('tingle_state_version');
  if (!isNonEmpty(v.profile_link)) missing.push('profile_link');
  if (!isNonEmpty(v.initialized_at)) missing.push('initialized_at');
  if (missing.length) return { status: 'incomplete', path: p, value: v, missing };
  return { status: 'ok', path: p, value: v };
}

/**
 * 读一个宿主文件（CLAUDE.md 或 AGENTS.md）里的常驻件标记区。
 * 回 present（区在，附版本与位置）或 absent（文件不在，或文件在但没有标记区）。
 */
function readResidentHost(cwd, host) {
  const p = path.join(cwd, host);
  const raw = readFileSafe(p);
  if (raw === null) return { status: 'absent', host, path: p, reason: '文件不在' };
  const b = raw.indexOf(RESIDENT_BEGIN);
  const e = raw.indexOf(RESIDENT_END);
  if (b === -1 || e === -1 || e < b) {
    return { status: 'absent', host, path: p, raw, reason: '文件在、没有标记区' };
  }
  const region = raw.slice(b, e + RESIDENT_END.length);
  const m = region.match(RESIDENT_VERSION_RE);
  return {
    status: 'present',
    host,
    path: p,
    version: m ? parseInt(m[1], 10) : null,
    region,
    raw,
    begin: b,
    end: e + RESIDENT_END.length,
  };
}

/**
 * 读本机常驻件——两个宿主都要看。
 *
 * 为什么两个都要：`CLAUDE.md` 管 Claude 侧、`AGENTS.md` 管 Codex 侧，双市场一次覆盖。
 * 只铺一侧，用另一侧的同事拿不到常驻件，而且没有任何症状。
 *
 * 回一个汇总：
 *   status   'present'（两侧都在且版本对）/ 'stale'（有一侧版本不对）/ 'absent'（有一侧没铺）
 *   hosts    逐宿主明细
 *   missing  没铺的宿主名
 *   stale    版本不对的宿主明细
 */
function readResident(cwd) {
  const hosts = RESIDENT_HOSTS.map(h => readResidentHost(cwd, h));
  const present = hosts.filter(h => h.status === 'present');
  const missing = hosts.filter(h => h.status === 'absent');
  const stale = present.filter(h => h.version !== RESIDENT_VERSION);
  let status = 'present';
  if (missing.length) status = 'absent';
  else if (stale.length) status = 'stale';
  return {
    status,
    hosts,
    present,
    missing,
    stale,
    // 兼容旧读法：第一个铺到的宿主
    host: present.length ? present[0].host : undefined,
    path: present.length ? present[0].path : undefined,
    version: present.length ? present[0].version : undefined,
  };
}

function residentTemplatePath() {
  return path.join(PLUGIN_ROOT, 'templates', '常驻件模版');
}

// ─────────────────────────────────────────────────────────────
// 读飞书：项目档案 / 云盘文件夹 / 探活
// ─────────────────────────────────────────────────────────────

/** 打开项目档案，读出正文里的 JSON。 */
function fetchProfile(link) {
  const r = larkJson(['docs', '+fetch', '--doc', link, '--doc-format', 'markdown', '--json']);
  if (!r.ok) return { ok: false, error: r.error || '档案打不开', code: r.code };
  const content = dig(r.data, 'data', 'document', 'content');
  if (typeof content !== 'string') {
    return { ok: false, error: '档案返回里没有正文内容' };
  }
  const j = extractJsonBlock(content);
  if (!j.ok) return { ok: false, error: j.error };
  return {
    ok: true,
    profile: j.value,
    content,
    revision: dig(r.data, 'data', 'document', 'revision_id'),
    documentId: dig(r.data, 'data', 'document', 'document_id'),
  };
}

/** 列一个云盘文件夹。用于探活，也用于找项目总索引。 */
function listFolder(folderToken) {
  const r = larkJson([
    'drive', 'files', 'list',
    '--params', JSON.stringify({ folder_token: folderToken, page_size: 200 }),
    '--json',
  ]);
  if (!r.ok) return { ok: false, error: r.error || '文件夹列不出来' };
  let files = dig(r.data, 'data', 'files');
  if (!Array.isArray(files)) files = dig(r.data, 'data', 'data', 'files');
  if (!Array.isArray(files)) files = [];
  return { ok: true, files };
}

/**
 * 探活一个地址：按类型轻访问一次，确证它活着、本人打得开。
 * 只判「打不打得开」，不读内容、不验任何合格条件。
 */
function probe(type, cfg) {
  if (type === 'lark-doc') {
    const r = larkJson(['drive', '+inspect', '--url', cfg.link, '--json']);
    if (!r.ok) return { ok: false, error: r.error || '文档打不开' };
    return { ok: true, title: dig(r.data, 'data', 'title') };
  }
  if (type === 'lark-base') {
    const r = larkJson([
      'base', '+base-get',
      '--base-token', cfg.base_token,
      '--json',
    ]);
    if (!r.ok) return { ok: false, error: r.error || '多维表格打不开' };
    return { ok: true, title: dig(r.data, 'data', 'app', 'name') };
  }
  if (type === 'lark-drive') {
    const r = listFolder(cfg.folder_token);
    if (!r.ok) return { ok: false, error: r.error };
    return { ok: true, count: r.files.length };
  }
  return { ok: false, error: '认不出的类型：' + type };
}

// ─────────────────────────────────────────────────────────────
// 项目档案的字段校验
// ─────────────────────────────────────────────────────────────

/** 项目字段齐不齐（不含版本号，版本号另判）。 */
function checkProfileFields(profile) {
  const missing = [];
  const need = [
    ['project', 'id'],
    ['project', 'name'],
    ['project', 'tags', '品类', '业务线'],
    ['project', 'tags', '品类', '合规类目'],
    ['project', 'tags', '品类', '产品品类'],
    ['project', 'tags', '品牌'],
    ['project', '阶段'],
    ['folder_token'],
  ];
  for (const p of need) {
    if (!isNonEmpty(dig(profile, ...p))) missing.push(p.join('.'));
  }
  if (!('initialized_at' in (profile || {}))) missing.push('initialized_at');
  return missing;
}

// ─────────────────────────────────────────────────────────────
// 命令：doctor
// ─────────────────────────────────────────────────────────────

function cmdDoctor() {
  const lacks = [];
  const notes = [];

  // 一、飞书命令行工具在不在
  const ver = lark(['--version'], { timeout: 15000 });
  const larkCliOk = ver.ok;
  if (!larkCliOk) {
    lacks.push({
      项: '飞书命令行工具',
      缺什么: 'lark-cli 没装或不在 PATH 上',
      怎么补: 'npx skills add larksuite/cli -g',
    });
  }

  // 二、配套技能目录在不在
  const skillHomes = [
    path.join(os.homedir(), '.claude', 'skills'),
    path.join(os.homedir(), '.agents', 'skills'),
  ];
  let larkSkills = false;
  for (const home of skillHomes) {
    try {
      if (fs.readdirSync(home).some(n => n.startsWith('lark-'))) { larkSkills = true; break; }
    } catch (e) { /* 目录不在，继续看下一个 */ }
  }
  if (!larkSkills) {
    lacks.push({
      项: '飞书配套技能目录',
      缺什么: '~/.claude/skills 或 ~/.agents/skills 下没有 lark-* 目录',
      怎么补: 'npx skills add larksuite/cli -g',
    });
  }

  // 三、授权：只认使用者本人身份，三态判定
  if (larkCliOk) {
    const auth = larkJson(['auth', 'status', '--json'], { timeout: 20000 });
    if (!auth.ok) {
      lacks.push({ 项: '飞书授权', 缺什么: '查不到授权状态：' + (auth.error || ''), 怎么补: 'lark-cli auth login' });
    } else {
      const user = dig(auth.data, 'identities', 'user') || dig(auth.data, 'data', 'identities', 'user');
      if (!user || user.available === false) {
        lacks.push({ 项: '飞书授权', 缺什么: '本人身份不在场（只认本人身份，应用身份不算）', 怎么补: 'lark-cli auth login' });
      } else {
        const st = String(user.tokenStatus || '');
        if (st === 'valid') {
          notes.push('飞书授权有效（本人身份）');
        } else {
          // 已过期但可能自动续：跑一条只读命令触发续期，续上即算过。
          const retry = larkJson(['auth', 'status', '--json'], { timeout: 20000 });
          const u2 = retry.ok
            ? (dig(retry.data, 'identities', 'user') || dig(retry.data, 'data', 'identities', 'user'))
            : null;
          if (u2 && String(u2.tokenStatus || '') === 'valid') {
            notes.push('飞书授权已自动续期（本人身份）');
          } else {
            lacks.push({
              项: '飞书授权',
              缺什么: `本人身份的授权续不回来（当前状态：${st || '判不出'}）`,
              怎么补: 'lark-cli auth login（需本人在浏览器完成）',
            });
          }
        }
      }
    }
  }

  // 四、插件自身在不在
  const pluginOk = existsSafe(path.join(PLUGIN_ROOT, 'skills')) && existsSafe(path.join(PLUGIN_ROOT, 'hooks'));
  if (!pluginOk) {
    lacks.push({ 项: 'tingle 插件', 缺什么: '插件目录不完整', 怎么补: '经插件市场重装 tingle' });
  }

  // 五、GitHub 命令行工具（自建 skill 提 PR 入仓要用）
  //     装没装＝缺一样（挡就绪）；登没登录＝只记一条，不挡——
  //     登录是提 PR 那一刻才用得上的一次浏览器操作，不该挡住一个从不造 skill 的人开工。
  const ghVer = run('gh', ['--version'], 15000);
  if (!ghVer.ok) {
    lacks.push({
      项: 'GitHub 命令行工具',
      缺什么: 'gh 没装或不在 PATH 上',
      怎么补: 'macOS：brew install gh；Windows：winget install --id GitHub.cli',
    });
  } else {
    const ghAuth = run('gh', ['auth', 'status'], 20000);
    notes.push(ghAuth.ok
      ? 'GitHub 命令行工具已装、已登录'
      : 'GitHub 命令行工具已装但未登录（只在给插件提 PR 时才用得上，届时跑 gh auth login）');
  }

  const payload = { 命令: 'doctor', 缺什么: lacks, 顺带查到的: notes };
  if (lacks.length === 0) {
    emit(payload, ['doctor：本机装备齐了。', ...bullet(notes)]);
    return 0;
  }
  emit(payload, [
    `doctor：缺 ${lacks.length} 样。`,
    ...lacks.map(l => `  - ${l.项}：${l.缺什么}\n    补法：${l.怎么补}`),
    ...bullet(notes),
  ]);
  return 1;
}

// ─────────────────────────────────────────────────────────────
// 命令：resolve
// ─────────────────────────────────────────────────────────────

function resolveCore(cwd) {
  // 第一层：本机指针
  const st = readState(cwd);
  if (st.status === 'missing') {
    return { 结论: VERDICT.NO_STATE, 点名: '本地指针', 说明: `${STATE_REL} 不存在`, 修法: '走项目初始化（project-readiness）' };
  }
  if (st.status === 'unparsable') {
    return { 结论: VERDICT.INCOMPLETE, 点名: '本地指针', 说明: st.reason, 修法: 'tingle migrate（照模板重建本地指针，纯本机动作）' };
  }
  if (st.status === 'incomplete') {
    return {
      结论: VERDICT.INCOMPLETE, 点名: '本地指针',
      说明: '这几栏缺或为空：' + st.missing.join('、'),
      修法: 'tingle migrate（照模板重建本地指针，纯本机动作）',
    };
  }
  if (st.value.tingle_state_version !== STATE_VERSION) {
    return {
      结论: VERDICT.STALE, 点名: '本地指针',
      说明: `结构版本 ${st.value.tingle_state_version}，当前应为 ${STATE_VERSION}`,
      修法: 'tingle migrate（照模板重建本地指针，纯本机动作）',
    };
  }

  // 第二层：项目档案
  const pf = fetchProfile(st.value.profile_link);
  if (!pf.ok) {
    return {
      结论: VERDICT.UNREACHABLE, 点名: '项目档案',
      说明: pf.error, 错误码: pf.code === undefined ? null : pf.code,
      档案链接: st.value.profile_link,
      修法: '按错误性质处置：链接失效或没权限找项目资源管理者；网络问题重试',
    };
  }
  const profile = pf.profile;
  if (profile.tingle_profile_version !== PROFILE_VERSION) {
    return {
      结论: VERDICT.STALE, 点名: '项目档案',
      说明: `结构版本 ${profile.tingle_profile_version}，当前应为 ${PROFILE_VERSION}`,
      档案链接: st.value.profile_link,
      修法: 'tingle migrate（试运行看清单 → 人放行 → 执行）',
    };
  }
  const fieldMiss = checkProfileFields(profile);
  if (fieldMiss.length) {
    return {
      结论: VERDICT.INCOMPLETE, 点名: '项目档案',
      说明: '这几项缺或为空：' + fieldMiss.join('、'),
      档案链接: st.value.profile_link,
      修法: '回 project-readiness 补打标／补登记（写飞书先放行）',
    };
  }

  // 第三层：项目总索引在不在
  // ——这一查改造前只靠 AI 自己记得做，2026-08-17 拍板并进本命令，变成程序硬查。
  const ls = listFolder(profile.folder_token);
  if (!ls.ok) {
    return {
      结论: VERDICT.UNREACHABLE, 点名: '项目云盘',
      说明: ls.error, 修法: '找项目资源管理者开云盘权限',
    };
  }
  const hasIndex = ls.files.some(f => String(f.name || '').startsWith(INDEX_TITLE));
  if (!hasIndex) {
    return {
      结论: VERDICT.INCOMPLETE, 点名: '项目总索引',
      说明: `项目云盘顶层没有「${INDEX_TITLE}」——多半是忘了建`,
      修法: 'tingle migrate（按现状建出总索引）',
    };
  }

  // 第四层：常驻件——两个宿主都要在、且版本都对。
  // 改造前这一层写的是「区在才判版本，不在不算错」，于是常驻件没铺开时 resolve 一声不吭；
  // 而 migrate 当时又要额外加参数才铺、初始化主手册压根没提它——三处同时断，
  // 结果是这套机制建好了却没有任何执行者会触发，也没有任何人会发现没触发。
  // 现在这一层是那条链的最后一道闸：没铺就报出来，修法是一条纯本机命令。
  const res = readResident(cwd);
  if (res.stale.length) {
    const one = res.stale[0];
    return {
      结论: VERDICT.STALE, 点名: '常驻件',
      说明: `${res.stale.map(h => h.host).join('、')} 里的结构版本 ${one.version === null ? '认不出' : one.version}，当前应为 ${RESIDENT_VERSION}`,
      宿主文件: res.stale.map(h => h.path),
      修法: 'tingle migrate（照模版重建标记区，区外一字不动，纯本机动作）',
    };
  }
  if (res.missing.length) {
    return {
      结论: VERDICT.INCOMPLETE, 点名: '常驻件',
      说明: `这几个宿主里没有常驻件：${res.missing.map(h => h.host).join('、')}`,
      宿主文件: res.missing.map(h => h.path),
      修法: 'tingle migrate（照模版铺进标记区，区外一字不动，纯本机动作）',
    };
  }

  return {
    结论: VERDICT.OK,
    项目: { id: dig(profile, 'project', 'id'), name: dig(profile, 'project', 'name') },
    档案链接: st.value.profile_link,
    项目云盘: profile.folder_token,
    常驻件: `在（${res.present.map(h => h.host).join('、')}）`,
    // 下面两项供 check 复用，免得同一份档案拉两遍；不进人读输出。
    _profile: profile,
    _state: st.value,
  };
}

/** 把 resolveCore 的内部字段摘掉再往外吐。 */
function publicVerdict(r) {
  const out = {};
  for (const [k, v] of Object.entries(r)) if (!k.startsWith('_')) out[k] = v;
  return out;
}

function cmdResolve(cwd) {
  const r = resolveCore(cwd);
  const lines = [`resolve：${r.结论}`];
  if (r.点名) lines.push(`  哪一份：${r.点名}`);
  if (r.说明) lines.push(`  说明：${r.说明}`);
  if (r.错误码 !== undefined && r.错误码 !== null) lines.push(`  错误码：${r.错误码}`);
  if (r.项目) lines.push(`  项目：${r.项目.name || ''}（${r.项目.id || ''}）`);
  if (r.档案链接) lines.push(`  档案：${r.档案链接}`);
  if (r.项目云盘) lines.push(`  云盘：${r.项目云盘}`);
  if (r.常驻件) lines.push(`  常驻件：${r.常驻件}`);
  if (r.修法) lines.push(`  修法：${r.修法}`);
  emit(Object.assign({ 命令: 'resolve' }, publicVerdict(r)), lines);
  return r.结论 === VERDICT.OK ? 0 : 1;
}

// ─────────────────────────────────────────────────────────────
// 命令：refresh
// ─────────────────────────────────────────────────────────────

function clearCacheFiles(cwd) {
  // 拉不到时：那两个文件若在，清空、各只留一行失效说明；不在就什么都不做。
  let cleared = 0;
  for (const rel of [CACHE_PROFILE_REL, CACHE_INDEX_REL]) {
    const p = path.join(cwd, rel);
    if (existsSafe(p)) {
      try { fs.writeFileSync(p, CACHE_STALE_LINE + '\n', 'utf8'); cleared++; } catch (e) { /* 尽力而为 */ }
    }
  }
  return cleared;
}

function cmdRefresh(cwd) {
  const st = readState(cwd);
  if (st.status !== 'ok') {
    // 锚不在或不完整时整段跳过：不创建缓存目录、不留空壳文件。
    emit({ 命令: 'refresh', 结果: '跳过', 原因: '本地指针不可用（' + st.status + '）' },
      ['refresh：跳过（本地指针不可用，不建缓存）']);
    return 0;
  }

  const pf = fetchProfile(st.value.profile_link);
  if (!pf.ok) {
    const n = clearCacheFiles(cwd);
    emit({ 命令: 'refresh', 结果: '拉不到', 原因: pf.error, 已清空: n },
      [`refresh：没拉到（${pf.error}）。已清空 ${n} 份旧副本，照常开工。`]);
    return 0; // 不挡开工
  }

  try { fs.mkdirSync(path.join(cwd, CACHE_DIR_REL), { recursive: true }); } catch (e) { /* ignore */ }
  let wrote = 0;
  try {
    fs.writeFileSync(path.join(cwd, CACHE_PROFILE_REL), JSON.stringify(pf.profile, null, 2) + '\n', 'utf8');
    wrote++;
  } catch (e) { /* ignore */ }

  // 第二件：顺档案顶层的云盘地址找总索引
  let indexOk = false;
  const ft = pf.profile.folder_token;
  if (isNonEmpty(ft)) {
    const ls = listFolder(ft);
    if (ls.ok) {
      const hit = ls.files.find(f => String(f.name || '').startsWith(INDEX_TITLE));
      if (hit && hit.url) {
        const doc = larkJson(['docs', '+fetch', '--doc', hit.url, '--doc-format', 'markdown', '--json']);
        const content = doc.ok ? dig(doc.data, 'data', 'document', 'content') : null;
        if (typeof content === 'string') {
          try {
            fs.writeFileSync(path.join(cwd, CACHE_INDEX_REL), content + '\n', 'utf8');
            wrote++; indexOk = true;
          } catch (e) { /* ignore */ }
        }
      }
    }
  }
  if (!indexOk) {
    const p = path.join(cwd, CACHE_INDEX_REL);
    if (existsSafe(p)) { try { fs.writeFileSync(p, CACHE_STALE_LINE + '\n', 'utf8'); } catch (e) { /* ignore */ } }
  }

  emit({ 命令: 'refresh', 结果: '已刷新', 写入份数: wrote, 总索引: indexOk ? '拉到' : '没拉到' },
    [`refresh：写入 ${wrote} 份（档案 ✓ / 总索引 ${indexOk ? '✓' : '×'}）`]);
  return 0;
}

// ─────────────────────────────────────────────────────────────
// 命令：migrate
// ─────────────────────────────────────────────────────────────

/** 本机件之一：照模板重建本地指针。纯本机动作，无须放行。 */
function rebuildState(cwd, keepLink) {
  const p = path.join(cwd, STATE_REL);
  const old = readState(cwd);
  const link = keepLink
    || (old.value && isNonEmpty(old.value.profile_link) ? old.value.profile_link : null);
  if (!link) {
    return { ok: false, error: '重建不了：拿不到项目档案链接（旧指针里没有，也没从命令行给）。请用 --profile-link <链接> 再跑一次。' };
  }
  const initialized = (old.value && isNonEmpty(old.value.initialized_at))
    ? old.value.initialized_at
    : new Date().toISOString().slice(0, 10);
  const next = {
    tingle_state_version: STATE_VERSION,
    profile_link: link,
    initialized_at: initialized,
  };
  if (existsSafe(p)) {
    try { fs.copyFileSync(p, p + '.bak-' + Date.now()); } catch (e) { /* 尽力而为 */ }
  }
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p, JSON.stringify(next, null, 2) + '\n', 'utf8');
  return { ok: true, path: p, value: next };
}

/** 照模版把常驻件铺进一个宿主文件。区外一字不动，覆盖前存档。 */
function rebuildResidentHost(cwd, host, block) {
  const cur = readResidentHost(cwd, host);

  if (cur.status === 'present') {
    if (cur.version === RESIDENT_VERSION && cur.region === block) {
      return { ok: true, host, path: cur.path, 动作: '无需处理' };
    }
    // 区内被人改过就是信号：留一份存档给人看，说明这里该判层。
    try { fs.copyFileSync(cur.path, cur.path + '.bak-' + Date.now()); } catch (e) { /* 尽力而为 */ }
    const next = cur.raw.slice(0, cur.begin) + block + cur.raw.slice(cur.end);
    fs.writeFileSync(cur.path, next, 'utf8');
    return { ok: true, host, path: cur.path, 动作: '重建标记区', 区内原文长度: cur.region.length };
  }

  // 没有标记区：文件不在就新建，文件在就在末尾追加，原有正文一字不动。
  const raw = cur.raw === undefined ? null : cur.raw;
  if (raw !== null) {
    try { fs.copyFileSync(cur.path, cur.path + '.bak-' + Date.now()); } catch (e) { /* 尽力而为 */ }
  }
  const next = (raw === null || raw.trim() === '' ? '' : raw.replace(/\s*$/, '\n\n')) + block + '\n';
  fs.writeFileSync(cur.path, next, 'utf8');
  return { ok: true, host, path: cur.path, 动作: raw === null ? '新建并写入标记区' : '首次写入标记区' };
}

/**
 * 本机件之二：照模版重建常驻件标记区，两个宿主都铺。
 *
 * 双宿主的理由见 readResident：`CLAUDE.md` 管 Claude 侧、`AGENTS.md` 管 Codex 侧。
 * 只铺一侧＝用另一侧的同事静默拿不到常驻件。
 */
function rebuildResident(cwd) {
  const tpl = readFileSafe(residentTemplatePath());
  if (tpl === null) return { ok: false, error: '插件仓里没有常驻件模版' };
  const block = RESIDENT_BEGIN + '\n' + tpl.trim() + '\n' + RESIDENT_END;
  const results = RESIDENT_HOSTS.map(h => rebuildResidentHost(cwd, h, block));
  const bad = results.filter(r => !r.ok);
  return {
    ok: bad.length === 0,
    error: bad.length ? bad.map(r => r.error).join('；') : undefined,
    results,
    动作: results.every(r => r.动作 === '无需处理')
      ? '无需处理'
      : results.map(r => `${r.host}：${r.动作}`).join('，'),
  };
}

/**
 * 项目档案 1 → 2。列出「将改什么」，人放行后才执行。
 * 2026-08-17 拍板：升级时顺手删掉 skills.context-distill.项目云盘
 * ——它跟顶层 folder_token 记的是同一件事，两处可读就是两个维护点。
 * 撤除放在这一步做，v1 的取值路径全程没断过（顶层字段正是从它取的值）。
 */
function planProfileMigration(profile) {
  const changes = [];
  const warnings = [];

  if (profile.tingle_profile_version === PROFILE_VERSION) {
    return { ok: false, error: '这份档案已经是版本 ' + PROFILE_VERSION + '，不必升级' };
  }
  if (profile.tingle_profile_version !== 1) {
    return {
      ok: false,
      error: `读到的档案版本是 ${profile.tingle_profile_version}，本升级只覆盖 1 → 2。停，交人判断。`,
    };
  }

  const next = JSON.parse(JSON.stringify(profile));
  next.tingle_profile_version = PROFILE_VERSION;
  changes.push(`版本号 1 → ${PROFILE_VERSION}`);

  // 第 0 步：取项目云盘坐标。版本 1 的档案顶层没有它，值记在蒸馏技能名下。
  let folderToken = profile.folder_token;
  const legacy = dig(profile, 'skills', 'context-distill', '项目云盘', 'folder_token');
  if (!isNonEmpty(folderToken)) {
    if (!isNonEmpty(legacy)) {
      return {
        ok: false,
        error: '取不到项目云盘地址：顶层没有 folder_token，skills.context-distill.项目云盘 也没有。停，向使用者问明本项目云盘顶层文件夹是哪一个。',
      };
    }
    folderToken = legacy;
    changes.push(`顶层新增 folder_token = ${folderToken}（从 skills.context-distill.项目云盘 取得）`);
  }
  next.folder_token = folderToken;

  // 各技能名下的输入整体缩进一层包进 inputs（键名与值一字不改，只改层级）
  if (next.skills && typeof next.skills === 'object') {
    for (const [skillName, block] of Object.entries(next.skills)) {
      if (!block || typeof block !== 'object') continue;
      if (block.inputs || block.outputs) continue; // 已经是新形状
      const inputs = {};
      for (const [k, v] of Object.entries(block)) inputs[k] = v;
      next.skills[skillName] = { inputs };
      const names = Object.keys(inputs);
      if (names.length) changes.push(`skills.${skillName} 下 ${names.length} 项输入缩进进 inputs：${names.join('、')}`);
    }
  }

  // 顺手撤掉重复记着云盘根的那一项
  if (dig(next, 'skills', 'context-distill', 'inputs', '项目云盘')) {
    delete next.skills['context-distill'].inputs['项目云盘'];
    changes.push('删掉 skills.context-distill.inputs.项目云盘（与顶层 folder_token 记的是同一件事）');
    if (Object.keys(next.skills['context-distill'].inputs).length === 0) {
      warnings.push('删完之后蒸馏技能名下没有声明输入了——这是预期的，它读的原料与模板不走档案登记。');
    }
  }

  // 迁移不发明落点
  changes.push('不写 outputs（迁移不发明落点；日后哪个技能真要写入时再补登记）');

  return { ok: true, next, changes, warnings, folderToken };
}

function cmdMigrate(cwd, argv) {
  const wantLocal = argv.includes('--local') || (!argv.includes('--profile'));
  const wantProfile = argv.includes('--profile');
  const apply = argv.includes('--apply');
  const linkIdx = argv.indexOf('--profile-link');
  const givenLink = linkIdx !== -1 ? argv[linkIdx + 1] : null;

  const done = [];

  // 本机两件：无须放行，直接做
  if (wantLocal) {
    const st = readState(cwd);
    const needStateRebuild = st.status !== 'ok' || st.value.tingle_state_version !== STATE_VERSION;
    if (needStateRebuild) {
      const r = rebuildState(cwd, givenLink);
      done.push(r.ok ? { 件: '本地指针', 结果: '已重建', 路径: r.path } : { 件: '本地指针', 结果: '重建失败', 原因: r.error });
    } else {
      done.push({ 件: '本地指针', 结果: '无需处理' });
    }

    // 常驻件：默认就铺，两个宿主都铺，不需要任何额外参数。
    // 原先要加 --write-resident 才铺，而那个参数 help 里没列、任何主手册也没提——
    // 等于这一件永远不会发生。纯本机动作、区外一字不动，没有理由设门槛。
    const r = rebuildResident(cwd);
    done.push(r.ok
      ? { 件: '常驻件', 结果: r.动作, 路径: r.results.map(x => x.path) }
      : { 件: '常驻件', 结果: '写入失败', 原因: r.error });
  }

  // 项目档案：先试运行吐清单，人放行（--apply）后才执行
  if (wantProfile) {
    const st = readState(cwd);
    const link = givenLink || (st.value && st.value.profile_link);
    if (!isNonEmpty(link)) {
      emit({ 命令: 'migrate', 结果: '停', 原因: '拿不到项目档案链接' },
        ['migrate：停——拿不到项目档案链接。用 --profile-link <链接> 指定。']);
      return 1;
    }
    const pf = fetchProfile(link);
    if (!pf.ok) {
      emit({ 命令: 'migrate', 结果: '停', 原因: pf.error }, ['migrate：停——' + pf.error]);
      return 1;
    }
    const plan = planProfileMigration(pf.profile);
    if (!plan.ok) {
      emit({ 命令: 'migrate', 结果: '停', 原因: plan.error }, ['migrate：停——' + plan.error]);
      return 1;
    }
    if (!apply) {
      emit(
        { 命令: 'migrate', 模式: '试运行', 档案: link, 将改什么: plan.changes, 提醒: plan.warnings },
        [
          'migrate（试运行，什么都没改）：档案 1 → 2 将做这几件事——',
          ...bullet(plan.changes),
          ...(plan.warnings.length ? ['  提醒：', ...bullet(plan.warnings)] : []),
          '',
          '这是写飞书的动作。人放行后加 --apply 再跑一次。',
        ]
      );
      return 0;
    }
    // 真执行归 project-readiness 走放行流程后调用；本命令只负责给出目标 JSON。
    emit(
      { 命令: 'migrate', 模式: '已放行', 档案: link, 将改什么: plan.changes, 目标JSON: plan.next },
      [
        'migrate：已放行，目标结构如下（写回动作由 project-readiness 执行：先存档旧版到 _tingle/，再原处覆盖，链接位置标题全不变，写完回读核对）。',
        JSON.stringify(plan.next, null, 2),
      ]
    );
    return 0;
  }

  emit({ 命令: 'migrate', 处理: done }, ['migrate：', ...done.map(d => `  - ${d.件}：${d.结果}${d.原因 ? '（' + d.原因 + '）' : ''}`)]);
  return done.some(d => String(d.结果).includes('失败')) ? 1 : 0;
}

// ─────────────────────────────────────────────────────────────
// 命令：check <技能名>
// ─────────────────────────────────────────────────────────────

function readSkillRequirements(skillName) {
  const p = path.join(PLUGIN_ROOT, 'skills', skillName, 'SKILL.md');
  const raw = readFileSafe(p);
  if (raw === null) return { ok: false, error: `找不到技能 ${skillName}（${p} 不存在）` };
  // 声明块是 SKILL.md 里第一个含 "requirements" 的 json 代码块
  const blocks = [...raw.matchAll(/```json\s*\r?\n([\s\S]*?)\r?\n```/g)];
  for (const b of blocks) {
    if (!b[1].includes('"requirements"')) continue;
    try {
      const v = JSON.parse(b[1]);
      if (v && v.requirements) return { ok: true, requirements: v.requirements, path: p };
    } catch (e) { /* 试下一块 */ }
  }
  return { ok: true, requirements: { inputs: {}, outputs: {} }, path: p, note: '这个技能没有声明块，按「无输入、无落点」处理' };
}

function cmdCheck(cwd, skillName) {
  if (!skillName) {
    emit({ 命令: 'check', 结果: '停', 原因: '没给技能名' }, ['check：要给技能名。用法 tingle check <技能名>']);
    return 2;
  }

  // 一读：技能的声明块
  const req = readSkillRequirements(skillName);
  if (!req.ok) {
    emit({ 命令: 'check', 技能: skillName, 结果: '停', 原因: req.error }, ['check：停——' + req.error]);
    return 2;
  }
  const declaredInputs = req.requirements.inputs || {};
  const declaredOutputs = req.requirements.outputs || {};

  // 二读：本地指针，连同项目档案的一整套前置判定。
  // 走的就是 resolve 那一份实现——判定逻辑全家只有一份，check 不另写一套。
  // 这一步不过就不必往下看登记了：档案版本不对时，登记的形状本来就是另一种，
  // 拿新形状去找旧结构只会报出方向不对的卡点。
  const r0 = resolveCore(cwd);
  if (r0.结论 !== VERDICT.OK) {
    emit(
      { 命令: 'check', 技能: skillName, 结果: '卡点单', 卡在: '项目还没就绪', resolve结论: publicVerdict(r0) },
      [
        `check ${skillName}：卡点单——项目还没就绪，本次不跑。`,
        `  resolve 说：${r0.结论}${r0.点名 ? '（' + r0.点名 + '）' : ''}`,
        r0.说明 ? `  说明：${r0.说明}` : null,
        `  修法：${r0.修法 || '走 project-readiness'}`,
      ]
    );
    return 1;
  }
  const profile = r0._profile;
  const st = { value: r0._state };

  const 开工单 = [];
  const 卡点 = [];
  const 运行时提供 = [];

  const reg = dig(profile, 'skills', skillName) || {};
  const regInputs = reg.inputs || {};
  const regOutputs = reg.outputs || {};

  // 三读：拿声明去档案对登记
  for (const [name, decl] of Object.entries(declaredInputs)) {
    // 「每次输入不一样」的那类：不进档案、不探活，只在开工单上记一行提醒。
    if (decl && decl[PER_RUN_KEY]) {
      运行时提供.push({ 输入: name, 说明: '每次输入不一样，由调用时当场给出' });
      continue;
    }
    const cfg = regInputs[name];
    if (!cfg) {
      卡点.push({ 缺什么: `输入「${name}」在项目档案里没有登记`, 谁能生产: (decl && decl.produced_by) || '—' });
      continue;
    }
    const type = cfg.type || (decl && decl.type);
    const need = TYPE_VALUE_FIELDS[type];
    if (!need) {
      卡点.push({ 缺什么: `输入「${name}」的类型认不出（${type}）`, 谁能生产: (decl && decl.produced_by) || '—' });
      continue;
    }
    const lackField = need.filter(f => !isNonEmpty(cfg[f]));
    if (lackField.length) {
      卡点.push({ 缺什么: `输入「${name}」登记不全，缺：${lackField.join('、')}`, 谁能生产: (decl && decl.produced_by) || '—' });
      continue;
    }
    // 四读：地址探活。只判打不打得开，不读内容、不验合格条件。
    const pr = probe(type, cfg);
    if (!pr.ok) {
      卡点.push({ 缺什么: `输入「${name}」地址打不开：${pr.error}`, 谁能生产: (decl && decl.produced_by) || '—' });
      continue;
    }
    开工单.push({ 输入: name, 类型: type, 地址: cfg.link || cfg.base_token || cfg.folder_token, 探活: '通' });
  }

  // 落点只核登记，不探活（它可能到写入时才创建，写不进去会当场报错、不会无声）
  for (const [name, decl] of Object.entries(declaredOutputs)) {
    const cfg = regOutputs[name];
    if (!cfg) {
      卡点.push({ 缺什么: `落点「${name}」在项目档案里没有登记`, 谁能生产: '—（落点由人在放行清单里给地址）' });
      continue;
    }
    const type = cfg.type || (decl && decl.type);
    const need = TYPE_VALUE_FIELDS[type];
    if (!need) {
      卡点.push({ 缺什么: `落点「${name}」的类型认不出（${type}）`, 谁能生产: '—' });
      continue;
    }
    const lackField = need.filter(f => !isNonEmpty(cfg[f]));
    if (lackField.length) {
      卡点.push({ 缺什么: `落点「${name}」登记不全，缺：${lackField.join('、')}`, 谁能生产: '—' });
      continue;
    }
    开工单.push({ 落点: name, 类型: type, 地址: cfg.link || cfg.base_token || cfg.folder_token });
  }

  if (卡点.length) {
    emit(
      { 命令: 'check', 技能: skillName, 结果: '卡点单', 卡点, 已通过: 开工单, 运行时提供 },
      [
        `check ${skillName}：卡点单（${卡点.length} 处）`,
        ...卡点.map(c => `  - ${c.缺什么}\n    谁能生产：${c.谁能生产}`),
        '',
        '本次不跑。修完重跑本命令复验。',
      ]
    );
    return 1;
  }

  emit(
    { 命令: 'check', 技能: skillName, 结果: '开工单', 开工单, 运行时提供 },
    [
      `check ${skillName}：开工单（${开工单.length} 项都通了）`,
      ...开工单.map(o => `  - ${o.输入 ? '读' : '写'} ${o.输入 || o.落点}（${o.类型}）：${o.地址}`),
      ...(运行时提供.length
        ? ['', '  这几样每次输入不一样，由调用时当场给出：', ...bullet(运行时提供.map(r => r.输入))]
        : []),
      '',
      '声明里那些合格条件程序不验——开跑时你自己逐条对照判。',
    ]
  );
  return 0;
}

// ─────────────────────────────────────────────────────────────
// 自动化（auto 命令族）
//
// 分工：本段只管机械的五件——收声明并校验、装到本机、按时唤起 agent、
// 记跑成什么样、撤掉。「这件活该不该自动、该定哪一档」全归
// building-automation 主手册，程序不判。
//
// **执行的真相源在本机**（`.tingle/automations.json`，与本地指针同一个交点：
// 随项目变 ＋ 只属于这台机器）。auto run 只读本机——早上九点机器醒来时
// 不联网、不看授权脸色、不要求项目已就绪，照跑。
// 飞书上那张公示表由 building-automation 在放行后登记，供防重复与交接；
// 它**不参与任何一次运行**，读不到也不影响。程序一如既往不写飞书。
// ─────────────────────────────────────────────────────────────

const AUTO_STORE_VERSION = 1;
const AUTO_STORE_REL = path.join('.tingle', 'automations.json');
const AUTO_RUNS_REL = path.join('.tingle', 'runs');
const AUTO_RUN_TIMEOUT_MS = 30 * 60 * 1000;

/** 声明里必须有值的格（前置条件可空，`_` 开头的是本机状态、不由人填）。 */
const AUTO_REQUIRED = [
  '触发类', '触发表达式', '动作说明', '输入从哪来',
  '产出写到哪', '危害档', '定档理由', '认领人', '开关',
];

/**
 * 危害档 → 两侧无头调用的机械闸。**这张表是唯一实现**；
 * building-automation 的参考件里那张是它的说明副本，两处不一致以本表为准。
 *
 * 一档的 Bash 白名单是 fail-closed 的：漏掉的命令跑不起来，使用者会来报；
 * 不会出现「漏了一条于是悄悄写出去了」。方向上宁可跑不动，不可跑过头。
 */
const HAZARD = {
  '一档-只看': {
    installable: true,
    claude: {
      allowedTools: [
        'Read', 'Glob', 'Grep', 'Skill',
        'Bash(lark-cli * list*)', 'Bash(lark-cli * get*)',
        'Bash(lark-cli * search*)', 'Bash(lark-cli schema*)',
      ],
      permissionMode: 'acceptEdits',
    },
    codex: { sandbox: 'read-only' },
  },
  '二档-写自家地盘': {
    installable: true,
    claude: {
      allowedTools: [
        'Read', 'Write', 'Edit', 'Glob', 'Grep', 'Skill',
        'Bash(lark-cli *)',
      ],
      permissionMode: 'acceptEdits',
    },
    codex: { sandbox: 'workspace-write' },
  },
  '三档-出门或抹改': {
    installable: false,
    拒装理由: '三档是对外或不可逆的动作，不许无人值守。拆成两条：一条二档的「发现并记下来」，一条人在场时才做的「发出去」。',
  },
};

/**
 * 触发源清单——**这是一份可增长的表，不是固定枚举**。
 * 加一种触发源＝往这张表加一行 ＋ 写它的装法；**动作层（提示词、危害档、旗标、日志）一个字不动**。
 * 触发源与动作层之间唯一的契约是一句：**该跑的时候调 `auto run <名字>`。**
 *
 * `装法` 四种：
 *   os-日历   → 操作系统按时点唤醒（launchd StartCalendarInterval／schtasks）
 *   os-盯路径 → 操作系统盯文件变化后唤醒（launchd WatchPaths；Windows 无对应物）
 *   会话内     → 不装任何常驻物，人在场时由会话入口捎带（因而不走无头那套）
 *   接力       → 不装任何常驻物，由上游那条跑完后唤起
 *   听着       → 需要一个常驻进程听外部事件（尚未实现，留位）
 */
const TRIGGERS = {
  '时点': {
    装法: 'os-日历',
    参数说明: '5 段 cron：分 时 日 月 周，用本机时区',
    无头: true, 已实现: true, 两侧: 'macOS 与 Windows 都行',
  },
  '文件变化': {
    装法: 'os-盯路径',
    参数说明: '要盯的路径，一行一个；相对路径按项目工作文件夹算',
    无头: true, 已实现: true, 两侧: '**只 macOS**——Windows 上没有对应的原生机制，本版不支持',
  },
  '一开工就跑': {
    装法: '会话内',
    参数说明: '节流：每次 ／ 每天一次 ／ 每周一次',
    无头: false, 已实现: true, 两侧: 'macOS 与 Windows 都行',
  },
  '跑完接力': {
    装法: '接力',
    参数说明: '上游那条自动化的名字',
    无头: true, 已实现: true, 两侧: 'macOS 与 Windows 都行',
  },
  '飞书事件': {
    装法: '听着',
    参数说明: '事件名，跑 `lark-cli event list` 看有哪些（如 minutes.minute.generated_v1）',
    无头: true, 已实现: true, 两侧: '**只 macOS**——要一个常驻进程，Windows 侧本版不支持',
  },
  '邮件到达': {
    装法: '听着',
    参数说明: '要盯的邮件文件夹，留空即收件箱（如 inbox）',
    无头: true, 已实现: true, 两侧: '**只 macOS**——同上',
  },
};

const 会话节流 = ['每次', '每天一次', '每周一次'];

/** 那一格可能写成「一档」「一档-只看」「一档 · 只看」，一律归到同一个键。 */
function hazardKey(raw) {
  const s = String(raw === undefined || raw === null ? '' : raw).trim();
  if (/^一档/.test(s)) return '一档-只看';
  if (/^二档/.test(s)) return '二档-写自家地盘';
  if (/^三档/.test(s)) return '三档-出门或抹改';
  return null;
}

// ── cron ────────────────────────────────────────────────────

const CRON_FIELDS = [
  { key: 'minute', min: 0, max: 59, plist: 'Minute' },
  { key: 'hour', min: 0, max: 23, plist: 'Hour' },
  { key: 'day', min: 1, max: 31, plist: 'Day' },
  { key: 'month', min: 1, max: 12, plist: 'Month' },
  { key: 'weekday', min: 0, max: 7, plist: 'Weekday' },
];

/** 一段 cron 字段 → null（每一个值都算）或升序取值数组；写法不合法回 {error}。 */
function parseCronField(spec, min, max) {
  if (spec === '*') return null;
  const out = new Set();
  for (const part of spec.split(',')) {
    let m;
    if ((m = part.match(/^\*\/(\d+)$/))) {
      const step = parseInt(m[1], 10);
      if (!step) return { error: `步长不能是 0：${part}` };
      for (let v = min; v <= max; v += step) out.add(v);
    } else if ((m = part.match(/^(\d+)-(\d+)(?:\/(\d+))?$/))) {
      const a = parseInt(m[1], 10), b = parseInt(m[2], 10);
      const step = m[3] ? parseInt(m[3], 10) : 1;
      if (!step || a > b || a < min || b > max) return { error: `区间写法不合法：${part}` };
      for (let v = a; v <= b; v += step) out.add(v);
    } else if ((m = part.match(/^(\d+)$/))) {
      const v = parseInt(m[1], 10);
      if (v < min || v > max) return { error: `取值超出 ${min}-${max}：${part}` };
      out.add(v);
    } else {
      return { error: `认不出的写法：${part}` };
    }
  }
  return Array.from(out).sort((a, b) => a - b);
}

/** 5 段 cron → { ok, fields } 或 { ok:false, error }。 */
function parseCron(expr) {
  const parts = String(expr || '').trim().split(/\s+/);
  if (parts.length !== 5) {
    return { ok: false, error: `时点要写成 5 段（分 时 日 月 周），现在是 ${parts.length} 段：${expr}` };
  }
  const fields = {};
  for (let i = 0; i < 5; i++) {
    const f = CRON_FIELDS[i];
    const r = parseCronField(parts[i], f.min, f.max);
    if (r && r.error) return { ok: false, error: `第 ${i + 1} 段（${f.key}）${r.error}` };
    // cron 里 0 与 7 都是周日，launchd 只认 0
    fields[f.key] = Array.isArray(r) && f.key === 'weekday'
      ? Array.from(new Set(r.map(v => (v === 7 ? 0 : v)))).sort((a, b) => a - b)
      : r;
  }
  return { ok: true, fields, raw: String(expr).trim() };
}

/**
 * cron → launchd 的 StartCalendarInterval 字典数组。
 * 值为 `*` 的段整段不写键——launchd 的语义就是「这一维不限」，与 cron 一致。
 */
function launchdIntervals(fields) {
  const active = CRON_FIELDS.filter(f => fields[f.key] !== null);
  if (!active.length) return { ok: false, error: '五段全是 *（每分钟都跑）——这不像是想要的，把时点写具体些' };
  let combos = [{}];
  for (const f of active) {
    const next = [];
    for (const base of combos) {
      for (const v of fields[f.key]) next.push(Object.assign({}, base, { [f.plist]: v }));
    }
    combos = next;
    if (combos.length > 200) {
      return { ok: false, error: '这个时点展开成了 200 条以上的日程，写法太细——换个粗一点的写法' };
    }
  }
  return { ok: true, intervals: combos };
}

// ── 本机这一份（执行的真相源）────────────────────────────────

function readAutoStore(cwd) {
  const p = path.join(cwd, AUTO_STORE_REL);
  const 空 = { tingle_automations_version: AUTO_STORE_VERSION, automations: {} };
  const raw = readFileSafe(p);
  if (raw === null) return { path: p, value: 空, 新的: true };
  try {
    const v = JSON.parse(raw);
    if (!v || typeof v !== 'object' || typeof v.automations !== 'object' || v.automations === null) {
      return { path: p, value: 空, 坏了: true };
    }
    return { path: p, value: v };
  } catch (e) {
    return { path: p, value: 空, 坏了: true };
  }
}

function writeAutoStore(cwd, value) {
  const p = path.join(cwd, AUTO_STORE_REL);
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p, JSON.stringify(value, null, 2) + '\n', 'utf8');
  return p;
}

/** 机械校验一份声明。只查「格齐不齐、写法对不对」，不判这活该不该自动。 */
function validateDeclaration(name, d) {
  const 毛病 = [];
  if (!/^[a-z0-9][a-z0-9-]*$/.test(String(name || ''))) {
    毛病.push(`名字「${name}」不合规——只许小写字母、数字与连字符，且不以连字符开头`);
  }
  for (const k of AUTO_REQUIRED) {
    if (!isNonEmpty(d[k])) 毛病.push(`「${k}」这一格是空的`);
  }
  const tg = TRIGGERS[String(d.触发类 || '').trim()];
  if (isNonEmpty(d.触发类) && !tg) {
    毛病.push(`触发类认不出：「${d.触发类}」——现有这几种：${Object.keys(TRIGGERS).join('／')}`);
  } else if (tg && !tg.已实现) {
    毛病.push(`触发类「${d.触发类}」还没实现（${tg.两侧}）——声明格式已经容得下它，等实现了原样收下`);
  }
  if (isNonEmpty(d.危害档) && !hazardKey(d.危害档)) {
    毛病.push(`危害档认不出：「${d.危害档}」——取值只有三个：一档-只看／二档-写自家地盘／三档-出门或抹改`);
  }
  if (isNonEmpty(d.开关) && !['启用', '停用'].includes(String(d.开关).trim())) {
    毛病.push(`开关是「${d.开关}」——取值只有「启用」「停用」两个`);
  }
  if (isNonEmpty(d.触发表达式) && tg && tg.已实现) {
    const 表达式 = String(d.触发表达式).trim();
    if (tg.装法 === 'os-日历') {
      const c = parseCron(表达式);
      if (!c.ok) 毛病.push(c.error);
    } else if (tg.装法 === 'os-盯路径') {
      const 路径 = 表达式.split(/\r?\n/).map(x => x.trim()).filter(Boolean);
      if (!路径.length) 毛病.push('文件变化触发要至少给一条路径');
      if (isWindows()) 毛病.push('文件变化这一类本版只支持 macOS——Windows 上没有对应的原生机制');
    } else if (tg.装法 === '会话内') {
      if (!会话节流.includes(表达式)) {
        毛病.push(`一开工就跑的触发表达式是节流档，取值只有：${会话节流.join('／')}；现在写的是「${表达式}」`);
      }
    } else if (tg.装法 === '接力') {
      if (表达式 === name) 毛病.push('跑完接力不能接自己');
    } else if (tg.装法 === '听着') {
      if (isWindows()) 毛病.push(`「${d.触发类}」这一类本版只支持 macOS——它要一个常驻进程`);
      if (d.触发类 === '飞书事件' && !/^[a-z][\w.]*$/.test(表达式)) {
        毛病.push(`飞书事件的触发表达式要写事件名（跑 lark-cli event list 看有哪些），现在写的是「${表达式}」`);
      }
    }
  }
  return { ok: 毛病.length === 0, 毛病 };
}

// ── 装到本机 ────────────────────────────────────────────────

function jobLabel(projectId, name) {
  const safe = s => String(s || '').replace(/[^A-Za-z0-9._-]/g, '-');
  return `com.tingle.${safe(projectId) || 'project'}.${safe(name)}`;
}

function plistEscape(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function launchdPlistPath(label) {
  return path.join(os.homedir(), 'Library', 'LaunchAgents', `${label}.plist`);
}

/**
 * 生成 launchd plist。`唤醒` 二选一：
 *   { 日历: [ {Minute:0,Hour:9}, … ] }   到点唤醒
 *   { 盯路径: ['/abs/path', …] }          路径变了唤醒（WatchPaths）
 */
function buildPlist(label, corePath, cwd, name, 唤醒, logDir) {
  const intervals = 唤醒.日历 || null;
  const 盯 = 唤醒.盯路径 || null;
  const 常驻 = Boolean(唤醒.常驻);
  const dicts = (intervals || []).map(d => {
    const inner = Object.entries(d)
      .map(([k, v]) => `      <key>${k}</key>\n      <integer>${v}</integer>`)
      .join('\n');
    return `    <dict>\n${inner}\n    </dict>`;
  }).join('\n');
  return [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
    '<plist version="1.0">',
    '<dict>',
    '  <key>Label</key>',
    `  <string>${plistEscape(label)}</string>`,
    '  <key>ProgramArguments</key>',
    '  <array>',
    `    <string>${plistEscape(corePath)}</string>`,
    '    <string>auto</string>',
    `    <string>${常驻 ? 'listen' : 'run'}</string>`,
    `    <string>${plistEscape(name)}</string>`,
    '    <string>--cwd</string>',
    `    <string>${plistEscape(cwd)}</string>`,
    '  </array>',
    ...(intervals ? [
      '  <key>StartCalendarInterval</key>',
      '  <array>',
      dicts,
      '  </array>',
    ] : []),
    ...(盯 ? [
      '  <key>WatchPaths</key>',
      '  <array>',
      ...盯.map(x => `    <string>${plistEscape(x)}</string>`),
      '  </array>',
    ] : []),
    '  <key>RunAtLoad</key>',
    常驻 ? '  <true/>' : '  <false/>',
    '  <key>KeepAlive</key>',
    常驻 ? '  <true/>' : '  <false/>',
    ...(常驻 ? ['  <key>ThrottleInterval</key>', '  <integer>30</integer>'] : []),
    '  <key>StandardOutPath</key>',
    `  <string>${plistEscape(path.join(logDir, name + '.launchd.out.log'))}</string>`,
    '  <key>StandardErrorPath</key>',
    `  <string>${plistEscape(path.join(logDir, name + '.launchd.err.log'))}</string>`,
    '  <key>EnvironmentVariables</key>',
    '  <dict>',
    '    <key>PATH</key>',
    `    <string>${plistEscape([path.join(os.homedir(), '.local', 'bin'), '/opt/homebrew/bin', '/usr/local/bin', '/usr/bin', '/bin', '/usr/sbin', '/sbin'].join(':'))}</string>`,
    '    <key>HOME</key>',
    `    <string>${plistEscape(os.homedir())}</string>`,
    '    <key>LANG</key>',
    '    <string>en_US.UTF-8</string>',
    '  </dict>',
    '</dict>',
    '</plist>',
    '',
  ].join('\n');
}

/** cron → schtasks 参数。只认四种常见写法，认不出就明说不支持，不硬凑。 */
function schtasksArgs(fields, label, corePath, cwd, name) {
  const one = k => (Array.isArray(fields[k]) && fields[k].length === 1 ? fields[k][0] : null);
  const any = k => fields[k] === null;
  const pad = n => String(n).padStart(2, '0');
  const cmd = `"${corePath}" auto run "${name}" --cwd "${cwd}"`;
  const base = ['/Create', '/F', '/TN', label, '/TR', cmd];

  const mi = one('minute'), h = one('hour');
  if (mi !== null && h !== null && any('day') && any('month') && any('weekday')) {
    return { ok: true, args: base.concat(['/SC', 'DAILY', '/ST', `${pad(h)}:${pad(mi)}`]) };
  }
  if (mi !== null && h !== null && any('day') && any('month') && Array.isArray(fields.weekday)) {
    const map = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
    return { ok: true, args: base.concat(['/SC', 'WEEKLY', '/D', fields.weekday.map(d => map[d]).join(','), '/ST', `${pad(h)}:${pad(mi)}`]) };
  }
  if (mi !== null && h !== null && Array.isArray(fields.day) && fields.day.length === 1 && any('month') && any('weekday')) {
    return { ok: true, args: base.concat(['/SC', 'MONTHLY', '/D', String(fields.day[0]), '/ST', `${pad(h)}:${pad(mi)}`]) };
  }
  if (Array.isArray(fields.minute) && fields.minute.length > 1 && any('hour') && any('day') && any('month') && any('weekday')) {
    const step = fields.minute[1] - fields.minute[0];
    if (step > 0) return { ok: true, args: base.concat(['/SC', 'MINUTE', '/MO', String(step)]) };
  }
  return { ok: false, error: 'Windows 上这条时点写法暂不支持——改成每日、每周、每月或每 N 分钟四种写法之一' };
}

function isWindows() { return process.platform === 'win32'; }

/**
 * 作业到底登记上没有——**看事实，不看命令的退出码**。
 * 起因：重复 bootstrap 一个已在册的作业会报「Bootstrap failed: 5」，
 * 而 bootout 与 bootstrap 之间有时差；只信退出码会在两个方向上都判错——
 * 装上了报失败，或没装上报成功。后者尤其坏：到点不跑，还没人知道。
 */
function jobRegistered(label) {
  if (isWindows()) {
    return runLocal('schtasks', ['/Query', '/TN', label]).ok;
  }
  return runLocal('launchctl', ['print', `gui/${process.getuid()}/${label}`]).ok;
}

function runLocal(file, args) {
  try {
    const out = execFileSync(file, args, { encoding: 'utf8', timeout: 30000, stdio: ['ignore', 'pipe', 'pipe'] });
    return { ok: true, stdout: out };
  } catch (e) {
    return { ok: false, error: ((e.stderr && String(e.stderr)) || e.message || '').trim().split('\n')[0] };
  }
}

// ── 唤起 agent ──────────────────────────────────────────────

function detectAgents() {
  const found = [];
  for (const name of ['claude', 'codex']) {
    const r = runLocal(isWindows() ? 'where' : 'which', [name]);
    if (r.ok && r.stdout.trim()) found.push(name);
  }
  return found;
}

function buildPrompt(name, d, projectId) {
  const 段 = [];
  段.push(`你正在为项目「${projectId}」执行一条已被授权的自动化。现场没有人可以追问。`);
  段.push('');
  段.push(`自动化名字：${name}`);
  段.push(`本次触发：定时触发（${d.触发表达式}）`);
  if (isNonEmpty(d.前置条件)) 段.push(`前置条件：${d.前置条件}`);
  段.push('');
  段.push('要干的活：');
  段.push(d.动作说明);
  段.push('');
  段.push('输入从哪来：');
  段.push(d.输入从哪来);
  段.push('');
  段.push('产出写到哪：');
  段.push(d.产出写到哪);
  段.push('');
  段.push('规矩（越一条即本次作废）：');
  段.push('- 前置条件不满足就什么都别做，只在结论里写明「前置条件不满足，本次不跑」。');
  段.push('- 只往上面写明的落点写，别处一律不写。');
  段.push('- 不许执行任何需要 --yes 的命令。');
  段.push('- 输入取不到就停，把取不到的是哪一样写进结论，不要找替代、不要猜。');
  段.push('- 判不准就停下，把判不准的地方写进结论，不要挑一个解释混过去。');
  段.push('- 最后输出一段结论：做了什么、产出在哪、有没有异常。');
  return 段.join('\n');
}

function buildAgentCommand(agent, hazard, prompt, cwd) {
  const gate = HAZARD[hazard];
  if (agent === 'claude') {
    const args = ['-p', prompt, '--permission-mode', gate.claude.permissionMode, '--allowedTools'];
    return { file: 'claude', args: args.concat(gate.claude.allowedTools), cwd };
  }
  if (agent === 'codex') {
    return {
      file: 'codex',
      args: ['exec', prompt, '--sandbox', gate.codex.sandbox, '-C', cwd, '--skip-git-repo-check'],
      cwd,
    };
  }
  return null;
}

/** 「听着」这一类的长驻命令：两种触发源、同一个形状（一行一个 JSON 流出来）。 */
function listenCommand(d) {
  const 表达式 = String(d.触发表达式 || '').trim();
  if (d.触发类 === '飞书事件') {
    return { file: 'lark-cli', args: ['event', 'consume', 表达式, '--quiet'] };
  }
  if (d.触发类 === '邮件到达') {
    const args = ['mail', '+watch', '--format', 'json'];
    if (表达式) args.push('--folders', JSON.stringify([表达式]));
    return { file: 'lark-cli', args };
  }
  return null;
}

/**
 * 筛选：程序只做**全文包含**匹配——筛选条件里空格分隔的每个词都得出现在这一行事件里。
 * 不做 jq、不做正则：同事写得出来的才叫能用；写错了的后果是不触发（fail-safe），
 * 不是乱触发。判"这条到底该不该处理"的细活留给被唤起的 agent。
 */
function 事件命中(line, 筛选条件) {
  const c = String(筛选条件 || '').trim();
  if (!c) return true;
  return c.split(/\s+/).every(w => line.includes(w));
}

/**
 * 装之前先试听一小会儿——**装上了却永远不响、还没人知道，是最坏的一种失败**。
 * 缺权限、事件没在后台订阅这类问题，此刻就能拿到确切的错与修法，不必等到某天发现"它怎么一直没动静"。
 */
function 听得到吗(d) {
  // 判据用退出码，不猜文本：consume 的超时是正常退出（码 0），报错是非零。
  // （曾按"第一行以 { 开头"去解析，而它吐的是多行美化 JSON，第一行只有一个左花括号，
  //   解析失败被吞掉，于是把"听不到"判成了"听得到"。改按退出码判。）
  const 摘错 = text => {
    let j = null;
    try { j = JSON.parse(text); } catch (e) { /* 不是整块 JSON，往下用正则 */ }
    if (j && j.error) return { error: String(j.error.message || '听不到'), hint: String(j.error.hint || '') };
    const m = text.match(/"message"\s*:\s*"([^"]+)"/);
    const h = text.match(/"hint"\s*:\s*"([^"]+)"/);
    return { error: m ? m[1] : (text.split('\n')[0] || '听不到').slice(0, 300), hint: h ? h[1] : '' };
  };
  if (d.触发类 === '飞书事件') {
    const r = lark(['event', 'consume', String(d.触发表达式).trim(), '--timeout', '4s', '--quiet'], { timeout: 25000 });
    if (r.ok) return { ok: true };
    return Object.assign({ ok: false }, 摘错(((r.stdout || '') + (r.stderr || '')).trim()));
  }
  if (d.触发类 === '邮件到达') {
    const r = lark(['mail', '+watch', '--format', 'json', '--dry-run'], { timeout: 25000 });
    if (r.ok) return { ok: true };
    return Object.assign({ ok: false }, 摘错(((r.stdout || '') + (r.stderr || '')).trim()));
  }
  return { ok: true };
}

function runsDir(cwd) {
  const d = path.join(cwd, AUTO_RUNS_REL);
  fs.mkdirSync(d, { recursive: true });
  return d;
}

function recordRun(cwd, name, payload) {
  const d = runsDir(cwd);
  try {
    fs.writeFileSync(path.join(d, `${name}.last.json`), JSON.stringify(payload, null, 2) + '\n', 'utf8');
    fs.appendFileSync(
      path.join(d, `${name}.log`),
      `[${payload.跑于}] ${payload.结果}｜用时 ${payload.用时秒}s｜agent ${payload.agent || '-'}｜${payload.说明 || ''}\n`,
      'utf8'
    );
  } catch (e) { /* 记不下来不该把这一次跑挂掉 */ }
}

/** 项目标识＝项目工作文件夹名（就绪契约的约定，取它不必联网）。 */
function projectIdOf(cwd) {
  return path.basename(path.resolve(cwd));
}

// ── 六条子命令 ──────────────────────────────────────────────

function cmdAutoAdd(cwd, file) {
  if (!file) { process.stderr.write('要收哪一份声明？tingle auto add <声明文件.json>\n'); return 2; }
  const raw = readFileSafe(path.resolve(file));
  if (raw === null) {
    emit({ 命令: 'auto add', 结果: '收不下', 说明: `读不到这个文件：${file}` },
      [`auto add：收不下`, `  说明：读不到这个文件：${file}`]);
    return 1;
  }
  let obj;
  try { obj = JSON.parse(raw); } catch (e) {
    emit({ 命令: 'auto add', 结果: '收不下', 说明: 'JSON 解析不了：' + e.message },
      ['auto add：收不下', '  说明：JSON 解析不了：' + e.message]);
    return 1;
  }
  const name = String(obj.名字 || '').trim();
  const d = Object.assign({}, obj);
  delete d.名字;

  const v = validateDeclaration(name, d);
  if (!v.ok) {
    emit({ 命令: 'auto add', 自动化: name, 结果: '收不下', 毛病: v.毛病 },
      [`auto add ${name || '（没名字）'}：收不下，${v.毛病.length} 处不合规`, ...bullet(v.毛病)]);
    return 1;
  }

  const store = readAutoStore(cwd);
  const 覆盖 = Boolean(store.value.automations[name]);
  const 旧本机 = 覆盖 ? store.value.automations[name]._本机 : undefined;
  store.value.tingle_automations_version = AUTO_STORE_VERSION;
  store.value.automations[name] = Object.assign({}, d, 旧本机 ? { _本机: 旧本机 } : {});
  const p = writeAutoStore(cwd, store.value);

  emit(
    { 命令: 'auto add', 自动化: name, 结果: 覆盖 ? '改好了' : '收下了', 危害档: hazardKey(d.危害档), 存在: p },
    [
      `auto add ${name}：${覆盖 ? '改好了' : '收下了'}（还没装，本机不会跑）`,
      `  时点：${d.触发表达式}｜危害档：${hazardKey(d.危害档)}｜开关：${d.开关}`,
      `  存在：${p}`,
      '',
      `  下一步：先试跑看它会干什么 → tingle auto run ${name} --dry-run`,
      `  确认无误再装上 → tingle auto install ${name}`,
    ]
  );
  return 0;
}

function cmdAutoList(cwd) {
  const store = readAutoStore(cwd);
  const names = Object.keys(store.value.automations).sort();
  const 条目 = names.map(n => {
    const d = store.value.automations[n];
    return {
      名字: n,
      触发: d.触发表达式,
      危害档: hazardKey(d.危害档),
      认领人: d.认领人,
      开关: d.开关,
      本机已装: Boolean(d._本机 && d._本机.label),
    };
  });
  emit(
    { 命令: 'auto list', 项目: projectIdOf(cwd), 共: 条目.length, 条目, 存在: store.path },
    [
      `auto list：本机这个项目下有 ${条目.length} 条自动化` + (store.坏了 ? '（原来那份读不出来，已当空的处理）' : ''),
      ...条目.map(c => `  ${c.本机已装 ? '●' : '○'} ${c.名字}｜${c.触发}｜${c.危害档}｜认领人 ${c.认领人}｜${c.开关}`),
      条目.length ? '' : '  （一条都没有。用 tingle auto add <声明文件.json> 收一条进来）',
      条目.length ? '  ● = 定时任务已装　○ = 只收了声明、还没装' : null,
    ]
  );
  return 0;
}

function cmdAutoInstall(cwd, name) {
  if (!name) { process.stderr.write('要装哪一条？tingle auto install <名字>\n'); return 2; }
  const store = readAutoStore(cwd);
  const d = store.value.automations[name];
  const 拒 = (说明, 修法) => {
    emit({ 命令: 'auto install', 自动化: name, 结果: '拒绝安装', 说明, 修法 },
      [`auto install ${name}：拒绝安装`, `  说明：${说明}`, 修法 ? `  修法：${修法}` : null]);
    return 1;
  };
  if (!d) return 拒(`本机没收过叫「${name}」的自动化`, '先 tingle auto add <声明文件.json> 把声明收进来');

  const v = validateDeclaration(name, d);
  if (!v.ok) return 拒(`本机存着的这份声明有 ${v.毛病.length} 处不合规：${v.毛病.join('；')}`, '改好声明重新 auto add');
  if (String(d.开关).trim() !== '启用') return 拒(`这条的开关是「${d.开关}」`, '要装先把声明里的开关改成「启用」，重新 auto add');

  const tg = TRIGGERS[String(d.触发类).trim()];
  const hz = hazardKey(d.危害档);
  // 危害档那道拒装闸**只对无头类触发生效**——人在场的触发本来就有人把关，
  // 三档（对外或不可逆）正是只许挂在这类触发上。
  if (tg.无头 && !HAZARD[hz].installable) return 拒(`这条是${hz}，而「${d.触发类}」是没人看着的触发`, HAZARD[hz].拒装理由);

  // 不装任何常驻物的两类：人在场时由会话入口捎带，或由上游跑完唤起。
  if (tg.装法 === '会话内' || tg.装法 === '接力') {
    d._本机 = { agent: null, 危害档: hz, label: null, 装于: new Date().toISOString(), 装法: tg.装法 === '会话内' ? '会话内捎带' : '由上游接力' };
    writeAutoStore(cwd, store.value);
    emit(
      { 命令: 'auto install', 自动化: name, 结果: '就位了', 触发类: d.触发类, 装法: d._本机.装法, 危害档: hz },
      [
        `auto install ${name}：就位了（这一类不装定时任务）`,
        tg.装法 === '会话内'
          ? `  它在你每次开工时由会话入口捎带，节流：${d.触发表达式}。人在场，所以不走无头那套。`
          : `  它在「${d.触发表达式}」跑成之后自动接上。`,
      ]
    );
    return 0;
  }

  const agents = detectAgents();
  if (!agents.length) return 拒('这台电脑上没找到可无头调用的 agent 命令行（claude／codex 都没有）', '先装上其中一个，再跑 tingle doctor 复验');
  const 旧 = d._本机 || {};
  const agent = agents.includes(旧.agent) ? 旧.agent : agents[0];

  const label = jobLabel(projectIdOf(cwd), name);
  const corePath = path.join(PLUGIN_ROOT, 'bin', 'tingle-core');
  const logDir = runsDir(cwd);

  // 盯路径：只 macOS，用 launchd 的 WatchPaths
  if (tg.装法 === 'os-盯路径') {
    if (isWindows()) return 拒('文件变化这一类本版只支持 macOS', 'Windows 上改用时点触发轮询近似');
    const 盯 = String(d.触发表达式).split(/\r?\n/).map(x => x.trim()).filter(Boolean)
      .map(x => (path.isAbsolute(x) ? x : path.resolve(cwd, x)));
    const plist = launchdPlistPath(label);
    fs.mkdirSync(path.dirname(plist), { recursive: true });
    fs.writeFileSync(plist, buildPlist(label, corePath, cwd, name, { 盯路径: 盯 }, logDir), 'utf8');
    runLocal('launchctl', ['bootout', `gui/${process.getuid()}/${label}`]);
    const r0 = runLocal('launchctl', ['bootstrap', `gui/${process.getuid()}`, plist]);
    if (!jobRegistered(label)) {
      return 拒(`定时任务登记失败：${r0.error || '命令跑完了，但系统里查不到这个作业'}`, `手工跑一遍 launchctl bootstrap gui/$(id -u) ${plist} 看它报什么`);
    }
    d._本机 = { agent, 危害档: hz, label, 装于: new Date().toISOString(), 装法: 'launchd 盯路径' };
    writeAutoStore(cwd, store.value);
    emit(
      { 命令: 'auto install', 自动化: name, 结果: '装上了', agent, 危害档: hz, 盯着: 盯, 装法: 'launchd 盯路径', 落点: plist },
      [
        `auto install ${name}：装上了（盯路径）`,
        ...bullet(盯.map(x => '盯着：' + x)),
        `  危害档：${hz}｜用哪个 agent 跑：${agent}`,
        `  装在：${plist}`,
        '  已复验：系统里查得到这个作业（不是只看命令退出码）。',
        '',
        '  提醒：路径一变它就醒——短时间内连着改多次会连着触发几次，动作本身要经得起重复跑。',
      ]
    );
    return 0;
  }

  // 听着：常驻进程，launchd KeepAlive 托着
  if (tg.装法 === '听着') {
    if (isWindows()) return 拒(`「${d.触发类}」这一类本版只支持 macOS`, '它要一个常驻进程，Windows 侧另设计');
    const 试听 = 听得到吗(d);
    if (!试听.ok) {
      return 拒(`现在听不到：${试听.error}`, 试听.hint || '把上面这条错处理掉再装——装上了却永远不响，比装不上更坏');
    }
    const plist = launchdPlistPath(label);
    fs.mkdirSync(path.dirname(plist), { recursive: true });
    fs.writeFileSync(plist, buildPlist(label, corePath, cwd, name, { 常驻: true }, logDir), 'utf8');
    runLocal('launchctl', ['bootout', `gui/${process.getuid()}/${label}`]);
    const r1 = runLocal('launchctl', ['bootstrap', `gui/${process.getuid()}`, plist]);
    if (!jobRegistered(label)) {
      return 拒(`常驻监听登记失败：${r1.error || '命令跑完了，但系统里查不到这个作业'}`, `手工跑一遍 launchctl bootstrap gui/$(id -u) ${plist} 看它报什么`);
    }
    d._本机 = { agent, 危害档: hz, label, 装于: new Date().toISOString(), 装法: 'launchd 常驻监听' };
    writeAutoStore(cwd, store.value);
    const lc = listenCommand(d);
    emit(
      { 命令: 'auto install', 自动化: name, 结果: '装上了', agent, 危害档: hz, 触发类: d.触发类, 听什么: `${lc.file} ${lc.args.join(' ')}`, 装法: 'launchd 常驻监听', 落点: plist },
      [
        `auto install ${name}：装上了（常驻监听）`,
        `  听的是：${lc.file} ${lc.args.join(' ')}`,
        d.筛选条件 ? `  筛选条件：${d.筛选条件}（这几个词都出现在事件里才算命中）` : '  筛选条件：没设——每一条事件都会触发',
        `  最小间隔：${Number(d.最小间隔秒) > 0 ? d.最小间隔秒 : 60} 秒（防止刷屏把额度打光）`,
        `  危害档：${hz}｜用哪个 agent 跑：${agent}`,
        '  已复验：系统里查得到这个作业。',
        '',
        '  它挂了由系统自动拉起来。要先看它听不听得到，直接跑：',
        `    tingle auto listen ${name} --cwd ${cwd}`,
      ]
    );
    return 0;
  }

  const cron = parseCron(d.触发表达式);
  if (!cron.ok) return 拒(cron.error, '时点写成 5 段 cron：分 时 日 月 周');

  let 装法, 落点;
  if (isWindows()) {
    const sa = schtasksArgs(cron.fields, label, corePath, cwd, name);
    if (!sa.ok) return 拒(sa.error, '换一种时点写法');
    const rWin = runLocal('schtasks', sa.args);
    if (!jobRegistered(label)) {
      return 拒(`任务计划登记失败：${rWin.error || '命令跑完了，但查不到这个任务'}`, '手工跑一遍 schtasks /Query /TN <任务名> 看它报什么');
    }
    装法 = '任务计划（schtasks）'; 落点 = label;
  } else {
    const ivs = launchdIntervals(cron.fields);
    if (!ivs.ok) return 拒(ivs.error, '把时点写具体些');
    const plist = launchdPlistPath(label);
    fs.mkdirSync(path.dirname(plist), { recursive: true });
    fs.writeFileSync(plist, buildPlist(label, corePath, cwd, name, { 日历: ivs.intervals }, logDir), 'utf8');
    runLocal('launchctl', ['bootout', `gui/${process.getuid()}/${label}`]); // 装过就先卸，幂等
    const r = runLocal('launchctl', ['bootstrap', `gui/${process.getuid()}`, plist]);
    if (!jobRegistered(label)) {
      return 拒(`定时任务登记失败：${r.error || '命令跑完了，但系统里查不到这个作业'}`, `手工跑一遍 launchctl bootstrap gui/$(id -u) ${plist} 看它报什么`);
    }
    装法 = 'launchd'; 落点 = plist;
  }

  d._本机 = { agent, 危害档: hz, label, 装于: new Date().toISOString(), 装法 };
  writeAutoStore(cwd, store.value);

  emit(
    { 命令: 'auto install', 自动化: name, 结果: '装上了', agent, 危害档: hz, 触发: cron.raw, 装法, 落点 },
    [
      `auto install ${name}：装上了`,
      `  时点：${cron.raw}（本机时区）`,
      `  危害档：${hz}`,
      `  用哪个 agent 跑：${agent}`,
      `  装在：${落点}（${装法}）`,
      '  已复验：系统里查得到这个定时任务（不是只看命令退出码）。',
      '',
      '  机器睡着时错过的那一次会在唤醒后补跑，不会跳过——所以「每天 9 点」的准确含义是「9 点，或当天开机的那一刻」。',
    ]
  );
  return 0;
}

function cmdAutoUninstall(cwd, name, argv) {
  if (!name) { process.stderr.write('要撤哪一条？tingle auto uninstall <名字>\n'); return 2; }
  const 连声明一起删 = argv.includes('--forget');
  const store = readAutoStore(cwd);
  const d = store.value.automations[name];
  if (!d) {
    emit({ 命令: 'auto uninstall', 自动化: name, 结果: '本机本来就没有这一条' },
      [`auto uninstall ${name}：本机本来就没有这一条，什么都没做`]);
    return 0;
  }
  const label = d._本机 && d._本机.label;
  if (label) {
    if (isWindows()) {
      runLocal('schtasks', ['/Delete', '/F', '/TN', label]);
    } else {
      runLocal('launchctl', ['bootout', `gui/${process.getuid()}/${label}`]);
      try { fs.unlinkSync(launchdPlistPath(label)); } catch (e) { /* 已经不在就算了 */ }
    }
    delete d._本机;
  }
  if (连声明一起删) delete store.value.automations[name];
  writeAutoStore(cwd, store.value);
  emit(
    { 命令: 'auto uninstall', 自动化: name, 结果: label ? '撤了' : '本来就没装', 声明还在: !连声明一起删 },
    [
      `auto uninstall ${name}：${label ? '定时任务撤了' : '它本来就没装上'}`,
      连声明一起删 ? '  声明也一起删了。' : '  声明还留着，将来要用 tingle auto install 就能再装回去（不想留就加 --forget）。',
    ]
  );
  return 0;
}

function cmdAutoRun(cwd, name, argv) {
  if (!name) { process.stderr.write('要跑哪一条？tingle auto run <名字>\n'); return 2; }
  const dry = argv.includes('--dry-run');
  const t0 = Date.now();
  const 记 = (结果, 说明, agent) => {
    if (dry) return;
    recordRun(cwd, name, {
      跑于: new Date().toISOString(), 结果, 说明: 说明 || '', agent: agent || null,
      用时秒: Math.round((Date.now() - t0) / 1000),
    });
  };
  const 报 = (结果, 说明, 修法) => {
    记(结果, 说明);
    emit({ 命令: 'auto run', 自动化: name, 结果, 说明, 修法 },
      [`auto run ${name}：${结果}`, `  说明：${说明}`, 修法 ? `  修法：${修法}` : null]);
    return 结果 === '跳过' ? 0 : 1;
  };

  const store = readAutoStore(cwd);
  const d = store.value.automations[name];
  if (!d) return 报('没跑成', `本机没有叫「${name}」的自动化`, '先 tingle auto add 把声明收进来');

  const v = validateDeclaration(name, d);
  if (!v.ok) return 报('没跑成', `声明有 ${v.毛病.length} 处不合规：${v.毛病.join('；')}`, '改好声明重新 auto add');
  if (String(d.开关).trim() !== '启用') return 报('跳过', `开关是「${d.开关}」`);

  const tg = TRIGGERS[String(d.触发类).trim()];
  if (tg && tg.装法 === '会话内') {
    // 不记运行日志——这是用法不对，不是"跑了一次没跑成"。记下去会把 status 弄脏，
    // 也会让人以为这条自动化坏了。
    const 说明 = '这一类是人在场时在会话里干的，不走无头进程';
    emit({ 命令: 'auto run', 自动化: name, 结果: '不该这么跑', 说明, 修法: `跑 tingle auto due 看它该干什么，干完用 tingle auto done ${name} 记一笔` },
      [`auto run ${name}：不该这么跑`, `  说明：${说明}`, `  修法：跑 tingle auto due 看它该干什么，干完用 tingle auto done ${name} 记一笔`]);
    return 2;
  }
  const hz = hazardKey(d.危害档);
  if (!HAZARD[hz].installable) return 报('没跑成', `${hz}不许无人值守`, HAZARD[hz].拒装理由);

  const agents = detectAgents();
  const 旧 = d._本机 || {};
  const agent = agents.includes(旧.agent) ? 旧.agent : agents[0];
  if (!agent) return 报('没跑成', '这台电脑上没找到 claude 或 codex');

  const prompt = buildPrompt(name, d, projectIdOf(cwd));
  const cmd = buildAgentCommand(agent, hz, prompt, cwd);

  if (dry) {
    emit(
      { 命令: 'auto run', 自动化: name, 结果: '试运行（没真跑）', agent, 危害档: hz, 将要执行: [cmd.file].concat(cmd.args), 提示词: prompt },
      [
        `auto run ${name} --dry-run：这是它到点会干的事，本次没真跑`,
        `  用哪个 agent：${agent}｜危害档：${hz}`,
        `  工作文件夹：${cwd}`,
        '',
        '  将要执行的命令（提示词太长，下面单列）：',
        `    ${cmd.file} ${cmd.args.map(a => (a === prompt ? '<提示词>' : a)).join(' ')}`,
        '',
        '  交给 agent 的提示词：',
        ...prompt.split('\n').map(l => '    ' + l),
      ]
    );
    return 0;
  }

  let 结果, 说明 = '', code = 0, tail = '';
  try {
    const out = execFileSync(cmd.file, cmd.args, {
      cwd, encoding: 'utf8', timeout: AUTO_RUN_TIMEOUT_MS,
      maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'],
    });
    结果 = '跑成了';
    tail = String(out || '').trim().split('\n').slice(-15).join('\n');
  } catch (e) {
    结果 = '跑挂了';
    code = typeof e.status === 'number' ? e.status : 1;
    说明 = ((e.stderr && String(e.stderr)) || e.message || '').trim().split('\n').slice(0, 3).join('；').slice(0, 400);
    tail = String((e.stdout && String(e.stdout)) || '').trim().split('\n').slice(-15).join('\n');
  }
  recordRun(cwd, name, {
    跑于: new Date().toISOString(), 结果, 说明, agent, 危害档: hz,
    用时秒: Math.round((Date.now() - t0) / 1000), 退出码: code, 尾部输出: tail,
  });
  // 接力：本条跑成了，唤起声明为「跑完接力」且上游是本条的那些。
  const 接力 = [];
  if (结果 === '跑成了') {
    for (const [n2, d2] of Object.entries(store.value.automations)) {
      if (n2 === name) continue;
      if (String(d2.触发类 || '').trim() !== '跑完接力') continue;
      if (String(d2.触发表达式 || '').trim() !== name) continue;
      if (String(d2.开关 || '').trim() !== '启用') continue;
      接力.push(n2);
    }
  }

  emit(
    { 命令: 'auto run', 自动化: name, 结果, agent, 危害档: hz, 退出码: code, 说明, 尾部输出: tail, 接力唤起: 接力 },
    [
      `auto run ${name}：${结果}`, 说明 ? `  说明：${说明}` : null,
      '', '  agent 最后说的话：', ...tail.split('\n').map(l => '    ' + l),
      接力.length ? `\n  接着唤起下游 ${接力.length} 条：${接力.join('、')}` : null,
    ]
  );
  // 逐条跑下游。只跑一层——下游的下游由它自己那次运行去唤，不在这里递归展开，
  // 免得一条链上出个环就把这次运行拖死。
  for (const n2 of 接力) {
    try { cmdAutoRun(cwd, n2, argv.filter(a => a !== '--dry-run')); } catch (e) { /* 下游挂了不该反过来把上游判成失败 */ }
  }
  return 结果 === '跑成了' ? 0 : 1;
}

/**
 * 常驻监听：起长驻命令，逐行读，命中就跑一次动作。
 * 由 launchd 以 KeepAlive 托着——它自己不管重启，挂了让 launchd 拉起来。
 */
function cmdAutoListen(cwd, name) {
  if (!name) { process.stderr.write('要听哪一条？tingle auto listen <名字>\n'); return 2; }
  const store = readAutoStore(cwd);
  const d = store.value.automations[name];
  if (!d) { process.stderr.write(`本机没有叫「${name}」的自动化\n`); return 1; }
  const tg = TRIGGERS[String(d.触发类).trim()];
  if (!tg || tg.装法 !== '听着') { process.stderr.write(`「${d.触发类}」不是要听的那一类\n`); return 2; }
  if (String(d.开关).trim() !== '启用') { process.stderr.write(`开关是「${d.开关}」，不听\n`); return 0; }

  const cmd = listenCommand(d);
  const 最小间隔秒 = Number(d.最小间隔秒) > 0 ? Number(d.最小间隔秒) : 60;
  let 上次触发 = 0;
  let 缓冲 = '';

  process.stderr.write(`[tingle] 开始听 ${name}：${cmd.file} ${cmd.args.join(' ')}（最小间隔 ${最小间隔秒}s）\n`);
  const child = spawn(cmd.file, cmd.args, { cwd, stdio: ['ignore', 'pipe', 'inherit'] });

  child.stdout.on('data', chunk => {
    缓冲 += chunk.toString('utf8');
    let i;
    while ((i = 缓冲.indexOf('\n')) !== -1) {
      const line = 缓冲.slice(0, i).trim();
      缓冲 = 缓冲.slice(i + 1);
      if (!line) continue;
      if (!事件命中(line, d.筛选条件)) continue;
      const now = Date.now();
      if (now - 上次触发 < 最小间隔秒 * 1000) {
        process.stderr.write(`[tingle] ${name} 命中但离上次不足 ${最小间隔秒}s，这条跳过\n`);
        continue;
      }
      上次触发 = now;
      process.stderr.write(`[tingle] ${name} 命中，跑一次\n`);
      try { cmdAutoRun(cwd, name, []); } catch (e) { process.stderr.write(`[tingle] ${name} 跑挂了：${e && e.message}\n`); }
    }
  });

  child.on('exit', code => {
    process.stderr.write(`[tingle] 听 ${name} 的那条命令退出了（码 ${code}）——交给 launchd 拉起来\n`);
    process.exit(code === null ? 1 : code);
  });
  return null; // 常驻，不返回退出码
}

/** 节流：这条「一开工就跑」的现在该不该跑。 */
function 该跑了吗(cwd, name, 节流) {
  if (节流 === '每次') return { 该跑: true, 上次: null };
  const raw = readFileSafe(path.join(cwd, AUTO_RUNS_REL, `${name}.last.json`));
  if (raw === null) return { 该跑: true, 上次: null };
  let last = null;
  try { last = JSON.parse(raw); } catch (e) { return { 该跑: true, 上次: null }; }
  if (!last || !last.跑于) return { 该跑: true, 上次: null };
  const 上次 = new Date(last.跑于);
  if (isNaN(上次.getTime())) return { 该跑: true, 上次: null };
  const 隔了天 = (Date.now() - 上次.getTime()) / 86400000;
  if (节流 === '每天一次') {
    const 同一天 = 上次.toDateString() === new Date().toDateString();
    return { 该跑: !同一天, 上次: last.跑于 };
  }
  if (节流 === '每周一次') return { 该跑: 隔了天 >= 7, 上次: last.跑于 };
  return { 该跑: true, 上次: last.跑于 };
}

/**
 * 「一开工就跑」那一类现在有哪几条该干。
 * 供会话入口调用：人在场，所以这一类不起无头进程，动作说明原样交给会话里的 AI 去干。
 */
function cmdAutoDue(cwd) {
  const store = readAutoStore(cwd);
  const 该干的 = [];
  for (const [n, d] of Object.entries(store.value.automations)) {
    const tg = TRIGGERS[String(d.触发类 || '').trim()];
    if (!tg || tg.装法 !== '会话内') continue;
    if (String(d.开关 || '').trim() !== '启用') continue;
    if (!(d._本机 && d._本机.装法)) continue; // 没就位的不算
    const j = 该跑了吗(cwd, n, String(d.触发表达式 || '每次').trim());
    if (!j.该跑) continue;
    该干的.push({
      名字: n, 节流: d.触发表达式, 上次跑于: j.上次,
      动作说明: d.动作说明, 输入从哪来: d.输入从哪来, 产出写到哪: d.产出写到哪,
      前置条件: d.前置条件 || '', 危害档: hazardKey(d.危害档),
    });
  }
  emit(
    { 命令: 'auto due', 项目: projectIdOf(cwd), 共: 该干的.length, 该干的 },
    该干的.length
      ? [
          `auto due：有 ${该干的.length} 条「一开工就跑」的现在该干`,
          ...该干的.flatMap(x => [
            ``,
            `  ── ${x.名字}（${x.节流}${x.上次跑于 ? '，上次 ' + x.上次跑于 : '，还没跑过'}）`,
            x.前置条件 ? `     前置条件：${x.前置条件}` : null,
            `     要干的活：${x.动作说明}`,
            `     输入从哪来：${x.输入从哪来}`,
            `     产出写到哪：${x.产出写到哪}`,
          ].filter(l => l !== null)),
          '',
          '  这一类人在场，就在会话里干，不起无头进程；干完一条跑 tingle auto done <名字> 记一笔。',
        ]
      : ['auto due：现在没有该干的（「一开工就跑」那一类）']
  );
  return 0;
}

/** 会话里干完了记一笔——节流靠它才算得准。 */
function cmdAutoDone(cwd, name, argv) {
  if (!name) { process.stderr.write('哪一条干完了？tingle auto done <名字>\n'); return 2; }
  const store = readAutoStore(cwd);
  if (!store.value.automations[name]) {
    emit({ 命令: 'auto done', 自动化: name, 结果: '记不下' }, [`auto done ${name}：本机没有这一条，没记`]);
    return 1;
  }
  const i = argv.indexOf('--note');
  const 说明 = i !== -1 && argv[i + 1] ? argv[i + 1] : '会话内干的';
  recordRun(cwd, name, { 跑于: new Date().toISOString(), 结果: '跑成了', 说明, agent: '会话内', 用时秒: 0 });
  emit({ 命令: 'auto done', 自动化: name, 结果: '记下了', 说明 }, [`auto done ${name}：记下了（${说明}）`]);
  return 0;
}

function cmdAutoStatus(cwd) {
  const store = readAutoStore(cwd);
  const d0 = path.join(cwd, AUTO_RUNS_REL);
  const 条目 = Object.keys(store.value.automations).sort().map(n => {
    const d = store.value.automations[n];
    const 本机 = d._本机 || {};
    let last = null;
    const raw = readFileSafe(path.join(d0, `${n}.last.json`));
    if (raw !== null) { try { last = JSON.parse(raw); } catch (e) { /* 日志坏了不该挡住看状态 */ } }
    const tg = TRIGGERS[String(d.触发类 || '').trim()];
    const 就位形态 = 本机.装法 || null;
    return {
      名字: n, 已装: Boolean(就位形态), 常驻或定时: Boolean(本机.label),
      触发类: d.触发类, 就位形态, agent: 本机.agent || null,
      危害档: hazardKey(d.危害档), 触发: d.触发表达式, 装于: 本机.装于 || null,
      上次跑于: last ? last.跑于 : null,
      上次结果: last ? last.结果 : '还没跑过',
      上次说明: last ? last.说明 : '',
    };
  });
  const 坏的 = 条目.filter(x => x.上次结果 === '跑挂了' || x.上次结果 === '没跑成');
  emit(
    { 命令: 'auto status', 项目: projectIdOf(cwd), 共: 条目.length, 已装: 条目.filter(x => x.已装).length, 上次没跑成的: 坏的.length, 条目 },
    [
      `auto status：本机这个项目下有 ${条目.length} 条，就位的 ${条目.filter(x => x.已装).length} 条`
        + (坏的.length ? `，其中 ${坏的.length} 条上次没跑成` : ''),
      ...条目.map(c => {
        const mark = c.上次结果 === '跑成了' ? '✓' : c.上次结果 === '还没跑过' ? '·' : '✗';
        const 形态 = c.已装 ? (c.常驻或定时 ? `${c.就位形态}／${c.agent}` : c.就位形态) : '还没就位';
        return `  ${mark} ${c.名字}｜${c.触发类}：${c.触发}｜${c.危害档}｜${形态}｜上次：${c.上次结果}${c.上次说明 ? '（' + c.上次说明 + '）' : ''}`;
      }),
      条目.length ? `\n  详细日志在 ${d0}` : '  （一条都没有）',
    ]
  );
  return 0;
}

function cmdAuto(cwd, argv) {
  const rest = positionalArgs(argv);
  const sub = rest[1] || '';
  const arg = rest[2] || '';
  switch (sub) {
    case 'add': return cmdAutoAdd(cwd, arg);
    case 'due': return cmdAutoDue(cwd);
    case 'listen': return cmdAutoListen(cwd, arg);
    case 'done': return cmdAutoDone(cwd, arg, argv);
    case 'list': return cmdAutoList(cwd);
    case 'install': return cmdAutoInstall(cwd, arg);
    case 'uninstall': return cmdAutoUninstall(cwd, arg, argv);
    case 'run': return cmdAutoRun(cwd, arg, argv);
    case 'status': return cmdAutoStatus(cwd);
    default:
      process.stderr.write(
        'auto 有九条：add <声明文件.json>（收一条进来）／list（本机有哪些）／install <名字>（装上）／'
        + 'run <名字> [--dry-run]（无头跑一次）／listen <名字>（常驻听事件，一般由系统托管）／'
        + 'due（人在场时有哪几条该干）／done <名字>（会话里干完了记一笔）／'
        + 'status（跑成什么样）／uninstall <名字> [--forget]（撤掉）\n'
      );
      return 2;
  }
}

// ─────────────────────────────────────────────────────────────
// 入口
// ─────────────────────────────────────────────────────────────

function usage() {
  process.stdout.write([
    'tingle-core —— tingle 插件的确定性核心',
    '',
    '用法：',
    '  tingle doctor                这台电脑装齐了没有',
    '  tingle resolve               这个项目在这台电脑上能不能直接开工',
    '  tingle refresh               把项目档案与总索引拉一份到本机缓存',
    '  tingle migrate               本机两件照模板重建（本地指针、常驻件；常驻件两侧都铺）',
    '  tingle migrate --profile     项目档案 1→2，先试运行吐清单',
    '  tingle migrate --profile --apply   人放行后，吐出目标结构',
    '  tingle check <技能名>        这个技能这一次能不能跑',
    '',
    '自动化（声明与状态都在本机；只有「听着」那一类会连飞书）：',
    '  tingle auto add <声明.json>  收一条自动化声明进来（只收不装）',
    '  tingle auto list             本机这个项目下有哪些自动化',
    '  tingle auto install <名字>   让它就位（按触发类：装日历／盯路径／常驻监听／会话内捎带）',
    '  tingle auto run <名字>       无头跑一次；加 --dry-run 只看它会干什么',
    '  tingle auto listen <名字>    常驻听飞书事件／新邮件（装上后由系统托管，一般不手敲）',
    '  tingle auto due              人在场时，现在有哪几条该干（会话入口用）',
    '  tingle auto done <名字>      会话里干完了记一笔（节流靠它）',
    '  tingle auto status           各条上次跑成什么样',
    '  tingle auto uninstall <名字> 撤掉定时任务；加 --forget 连声明一起删',
    '',
    '通用参数：',
    '  --json           吐 JSON 而不是人读格式',
    '  --cwd <路径>     指定项目工作文件夹（默认当前目录）',
    '',
  ].join('\n') + '\n');
}

/**
 * 取位置参数：跳过所有旗标，**并跳过 --cwd 后面那个值**。
 * 不跳它的话，`tingle check --cwd <路径> <技能名>` 会把路径当技能名——
 * 这是 0.10.0 之前就在的毛病，加 auto 命令时被实测撞出来，一并修掉。
 */
function positionalArgs(argv) {
  const out = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--cwd') { i++; continue; }
    if (a.startsWith('-')) continue;
    out.push(a);
  }
  return out;
}

function main() {
  const argv = process.argv.slice(2);
  WANT_JSON = argv.includes('--json');

  const cwdIdx = argv.indexOf('--cwd');
  const cwd = cwdIdx !== -1 ? path.resolve(argv[cwdIdx + 1]) : process.cwd();

  const cmd = argv.find(a => !a.startsWith('-')) || '';

  try {
    switch (cmd) {
      case 'doctor': return cmdDoctor();
      case 'resolve': return cmdResolve(cwd);
      case 'refresh': return cmdRefresh(cwd);
      case 'migrate': return cmdMigrate(cwd, argv);
      case 'auto': return cmdAuto(cwd, argv);
      case 'check': return cmdCheck(cwd, positionalArgs(argv)[1]);
      case '':
      case 'help':
      case '--help':
        usage(); return 0;
      default:
        process.stderr.write(`认不出的命令：${cmd}\n`);
        usage(); return 2;
    }
  } catch (e) {
    // 程序自身出错要显式报出来，不许静默当成「判过了」
    const msg = e && e.stack ? e.stack : String(e);
    if (WANT_JSON) {
      process.stdout.write(JSON.stringify({ 结果: '程序自身出错', 说明: msg }, null, 2) + '\n');
    } else {
      process.stderr.write('tingle-core 自身出错（不是判定结论）：\n' + msg + '\n');
    }
    return 3;
  }
}

// 常驻命令（auto listen）返回 null——它要一直跑着，这里不能 exit，
// 否则刚起来的监听进程当场被自己杀掉。
const 退出码 = main();
if (退出码 !== null) process.exit(退出码);
